---
import BlogFeed from "./BlogFeed.astro";
import { getCollection } from "astro:content";

const total = (await getCollection("blog")).length;
const LIMIT = 3;
---

<section id="blog" class="w-full flex flex-col items-center justify-center z-10">
    <div
        class="w-full max-w-7xl flex flex-col pt-12 sm:pt-24 pb-6 gap-8 px-4 sm:px-6 border-x border-stroke-weak-dark"
    >
        <h2 class="text-4xl sm:text-5xl font-medium">Blog</h2>
    </div>

    <BlogFeed limit={LIMIT} />

    {
        total > LIMIT && (
            <div class="w-full flex flex-col items-center">
                <a
                    href="/blog"
                    class="method-card w-full max-w-7xl border-x border-b border-stroke-weak-dark flex items-center justify-center gap-2 p-6 mono text-blue-light hover:underline"
                >
                    Read all posts →
                </a>
            </div>
        )
    }
</section>
