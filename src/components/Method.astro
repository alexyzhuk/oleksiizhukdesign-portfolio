        title: "Evaluate",
        description:
            "Test and validate solutions to make sure they address the problem. Analyze feedback to extract valuable insights that can inform the next steps.",
        labelColor: "decoration-red-light",
    },
];
---

<section
    id="method"
    class="min-h-fit w-full flex flex-col items-center justify-center z-10"
>
    <!-- Header Section -->
    <div
        class="w-full max-w-7xl flex flex-col pt-12 sm:pt-24 pb-6 gap-8 px-4 sm:px-6 border-x border-stroke-weak-dark"
    >
        <h2 class="text-4xl sm:text-5xl font-medium">Design Approach</h2>
        <p
            class="text-lg text-balance leading-10 text-text-secondary max-w-prose"
        >
            I am a huge advocate of the design thinking and humanity-centered
            approaches. After designing for multiple teams at the same time I
            developed the 4-stage method that leads to a desirable outcome every
            time.
        </p>
    </div>

    <!-- Grid Container -->
    <div class="flex w-full flex-col border-y border-stroke-weak-dark">
        {
            [0, 2].map((rowStart) => (
                <>
                    {/* Row Container */}
                    <div class="w-full flex flex-col items-center justify-center">
                        <div class="w-full max-w-7xl border-x border-stroke-weak-dark">
                            <div class="grid grid-cols-1 md:grid-cols-2">
                                {stages
                                    .slice(rowStart, rowStart + 2)
                                    .map((stage, colIndex) => (
                                        <div
                                            class:list={[
                                                "method-card group relative overflow-hidden border-stroke-weak-dark p-8 sm:p-12 min-h-fit has-cursor-pointer",
                                                // Right border for left column card on desktop
                                                colIndex === 0 && "md:border-r",
                                                // Top border for right column cards (2nd and 4th stages) on mobile only
                                                colIndex === 1 &&
                                                    "border-t md:border-t-0",
                                            ]}
                                        >
                                            {/* Icon */}
                                            <div
                                                class="method-icon"
                                                set:html={stage.svg}
                                            />

                                            {/* Text Content */}
                                            <div class="method-text-container">
                                                <div class="min-h-32 flex flex-col justify-between">
                                                    <p
                                                        class={`method-label mono font-light text-lg sm:text-xl text-text-primary underline ${stage.labelColor} underline-offset-8 decoration-1`}
                                                    >
                                                        {stage.label}
                                                    </p>
                                                    <h3 class="method-text text-3xl sm:text-4xl text-text-primary mt-4">
                                                        {stage.title}
                                                    </h3>
                                                </div>

                                                <p class="method-text text-base sm:text-lg text-text-secondary leading-7 sm:leading-9 sm:text-balance">
                                                    {stage.description}
                                                </p>
                                            </div>
                                        </div>
                                    ))}
                            </div>
                        </div>
                    </div>

                    {/* Full-width separator between rows */}
                    {rowStart === 0 && (
                        <div class="w-full border-t border-stroke-weak-dark" />
                    )}
                </>
            ))
        }
    </div>
</section>

<script>
    // Intersection Observer for mobile scroll animations
    const isMobile = window.innerWidth < 768;

    if (isMobile) {
        const cards = document.querySelectorAll(".method-card");

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("active");
                    } else {
                        entry.target.classList.remove("active");
                    }
                });
            },
            {
                threshold: 0.5,
                rootMargin: "-25% 0px -25% 0px",
            },
        );

        cards.forEach((card) => {
            observer.observe(card);
        });

        window.addEventListener("beforeunload", () => {
            cards.forEach((card) => {
                observer.unobserve(card);
            });
        });
    }
</script>
