---
// Navigation is the same on all pages, no props needed
---

<nav
    id="navigation"
    class="nav-container top-0 left-0 right-0 z-1000 fixed border-y border-stroke-weak-dark"
>
    <div
        class="max-w-7xl mx-auto flex flex-col border-x border-stroke-weak-dark"
    >
        <!-- Header Bar -->
        <div class="flex pl-4 pr-3 py-2 justify-between items-center">
            <div class="flex items-center gap-2 sm:gap-3">
                <a
                    href="/"
                    class="flex text-text-primary h-10 w-10 sm:h-12 sm:w-12
            items-center justify-center shrink-0 z-50 logo-btn"
                >
                    <img
                        src="/main-logo.svg"
                        alt="Oleksii Zhuk"
                        class="h-7 sm:h-8"
                    />
                </a>

                <span
                    class="h-6 sm:h-8 w-px shrink-0 bg-stroke-weak-dark"
                    aria-hidden="true"></span>

                <div class="flex pl-1 items-center gap-2 w-fit shrink-0">
                    <span class="relative flex h-2 w-2 shrink-0">
                        <span
                            class="absolute inline-flex h-full w-full rounded-full bg-green-light opacity-75 animate-ping"
                        ></span>
                        <span
                            class="relative inline-flex h-2 w-2 rounded-full bg-green-light"
                        ></span>
                    </span>
                    <span
                        class="mono text-[11px] uppercase tracking-widest text-text-secondary"
                        >Available for projects</span
                    >
                </div>
            </div>

            <div>
                <!-- Desktop Menu -->
                <div class="hidden sm:flex gap-1">
                    <a
                        href="/#selected-work"
                        class="nav-item nav-text nav-work
            text-text-primary"
                    >
                        <span>/</span> work
                    </a>

                    <a
                        href="/about"
                        class="nav-item nav-text nav-about text-text-primary"
                    >
                        <span>/</span> about
                    </a>

                    <a
                        href="/blog"
                        class="nav-item nav-text nav-blog text-text-primary"
                    >
                        <span>/</span> blog
                    </a>

                    <a
                        href="/#contacts"
                        class="nav-item nav-text nav-contacts text-text-primary"
                    >
                        <span>/</span> contacts
                    </a>
                </div>

                <!-- Mobile Menu Button -->
                <button
                    id="mobile-menu-button"
                    class="sm:hidden relative z-50 p-4"
                    aria-label="Toggle menu"
                >
                    <div class="w-6 h-5 flex flex-col justify-between">
                        <span
                            class="hamburger-line block w-full h-0.5 bg-text-primary transition-all duration-500 origin-center"
                        ></span>
                        <span
                            class="hamburger-line block w-full h-0.5 bg-text-primary transition-all duration-300"
                        ></span>
                        <span
                            class="hamburger-line block w-full h-0.5 bg-text-primary transition-all duration-500 origin-center"
                        ></span>
                    </div>
                </button>
            </div>
        </div>
        <!-- Mobile Menu Items (inside nav container) -->
        <div
            id="mobile-menu"
            class="mobile-menu-expanded sm:hidden overflow-hidden border-t border-stroke-weak-dark"
        >
            <div class="flex flex-col">
                <a
                    href="/#selected-work"
                    class="nav-text mobile-nav-item nav-work text-text-primary px-6 py-4 border-b border-stroke-weak-dark border-dashed"
                >
                    <span>/</span> work
                </a>

                <a
                    href="/about"
                    class="nav-text mobile-nav-item nav-about text-text-primary px-6 py-4 border-b border-stroke-weak-dark border-dashed"
                >
                    <span>/</span> about
                </a>

                <a
                    href="/blog"
                    class="nav-text mobile-nav-item nav-blog text-text-primary px-6 py-4 border-b border-stroke-weak-dark border-dashed"
                >
                    <span>/</span> blog
                </a>

                <a
                    href="/#contacts"
                    class="nav-text mobile-nav-item nav-contacts text-text-primary px-6 py-4"
                >
                    <span>/</span> contacts
                </a>
            </div>
        </div>
    </div>
</nav>

<script>
    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    const navigation = document.getElementById("navigation");
    const mobileNavItems = document.querySelectorAll(".mobile-nav-item");

    let isMenuOpen = false;

    function toggleMenu() {
        isMenuOpen = !isMenuOpen;
        const lines = mobileMenuButton?.querySelectorAll(".hamburger-line");

        if (isMenuOpen) {
            // Open menu - expand navbar
            mobileMenu?.classList.add("menu-open");
            navigation?.classList.add("nav-expanded");

            // Animate hamburger to X
            if (lines) {
                lines[0].style.transform =
                    "rotate(45deg) translateY(6px) translateX(7px)";
                lines[1].style.opacity = "0";
                lines[2].style.transform =
                    "rotate(-45deg) translateY(-6px) translateX(7px)";
            }
        } else {
            // Close menu - collapse navbar
            mobileMenu?.classList.remove("menu-open");
            navigation?.classList.remove("nav-expanded");

            // Animate X back to hamburger
            if (lines) {
                lines[0].style.transform = "none";
                lines[1].style.opacity = "1";
                lines[2].style.transform = "none";
            }
        }
    }

    // Toggle menu on button click
    mobileMenuButton?.addEventListener("click", toggleMenu);

    // Close menu when clicking nav items
    mobileNavItems.forEach((item) => {
        item.addEventListener("click", () => {
            if (isMenuOpen) {
                toggleMenu();
            }
        });
    });

    // Close menu on escape key
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isMenuOpen) {
            toggleMenu();
        }
    });

    // Scroll detection for background change
    let isScrolled = false;

    const handleScroll = () => {
        const scrollPosition = window.scrollY;

        if (scrollPosition > 50 && !isScrolled) {
            isScrolled = true;
            navigation?.classList.add("nav-scrolled");
        } else if (scrollPosition <= 50 && isScrolled) {
            isScrolled = false;
            navigation?.classList.remove("nav-scrolled");
        }
    };

    window.addEventListener("scroll", handleScroll);
    handleScroll();
</script>
