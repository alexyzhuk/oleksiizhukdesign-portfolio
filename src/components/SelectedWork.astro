---
const projects = [
    {
        company: "datuum.ai",
        title: "Democratizing the Data",
        description:
            "In 2021 we started building a product with a vision to simplify data integration for everyone. Little did I know I was going to help create an extremely powerful tool the business world has yet to discover.",
        scope: [
            "Big Data",
            "AI",
            "Startup",
            "B2B SaaS",
            "Web App",
            "Product Design",
            "UI/UX",
        ],
        years: "2022-2024",
        image: "/datuum-cover.avif",
        link: "/case-study-datuum",
        stats: [
            { value: "+14%", label: "task success rate" },
            { value: "-37%", label: "time on task" },
        ],
    },
    {
        company: "Osvita XXI",
        title: "Education for Life",
        description:
            "In 2023 Osvita XXI asked me to create a website to support their grant application, providing a comprehensive and accessible platform to showcase their project and its potential impact.",
        scope: ["Web Design", "UI/UX Design", "Branding"],
        years: "2023",
        image: "/osvita-cover.avif",
        link: "/case-study-osvita",
        stats: [
            { value: "10x", label: "daily active users" },
            { value: "+40%", label: "mobile visits" },
        ],
    },
];
---

<section
    id="selected-work"
    class="min-h-screen w-full flex flex-col items-center justify-center z-10"
>
    <div
        class="w-full max-w-7xl flex flex-col pt-12 sm:pt-24 pb-6 gap-8 px-4 sm:px-6 border-x border-stroke-weak-dark"
    >
        <!-- Section Header -->
        <h2 class="text-4xl sm:text-5xl font-medium">Portfolio</h2>
        <p
            class="sm:text-lg text-balance leading-loose text-text-secondary max-w-[64ch]"
        >
            After more than 10 years of work I've completed 40+ projects. Below
            I've listed the most prominent work that helped products grow and
            progress defying challenges that came along the way.
        </p>
    </div>
    <!-- Project Cards -->
    <div class="flex w-full flex-col">
        {
            projects.map((project, index) => {
                const minDuplicates = project.scope.length < 5 ? 6 : 3;
                const duplicatedScope = Array(minDuplicates)
                    .fill(project.scope)
                    .flat();

                return (
                    <>
                        <div class="w-full flex flex-col items-center justify-center border-y border-stroke-weak-dark">
                            <a
                                href={project.link}
                                class="project-card flex flex-col w-full max-w-7xl group transition-all duration-300 border-x border-stroke-weak-dark bg-bg-plaque"
                            >
                                <div class="flex flex-col-reverse sm:flex-row border-b border-stroke-weak-dark">
                                    {/* Content Side */}
                                    <div class="content-section flex flex-col w-full sm:min-w-1/2 md:min-w-xl tracking-tight sm:border-r border-stroke-weak-dark">
                                        <div class="flex flex-col px-4 py-8 sm:p-12 gap-4 items-start text-balance grow ">
                                            <div class="flex flex-col justify-start gap-4 w-full">
                                                <h3 class="text-3xl sm:text-4xl">
                                                    {project.title}
                                                </h3>
                                                <p class="case-description text-base text-text-secondary leading-8">
                                                    {project.description}
                                                </p>
                                            </div>
                                            <div class="flex flex-col gap-6 w-full justify-end grow">
                                                <div class="flex items-start text-lg leading-8 text-text-primary gap-2 w-full">
                                                    <div class="flex flex-col items-start gap-1 text-lg sm:text-xl w-full">
                                                        <span class="lowercase mono text-sm sm:text-base text-blue-light">
                                                            Company
                                                        </span>
                                                        {project.company}
                                                    </div>
                                                    <div class="flex flex-col items-start gap-1 text-lg sm:text-xl w-full">
                                                        <span class="lowercase mono text-sm sm:text-base text-red-light">
                                                            Years
                                                        </span>
                                                        {project.years}
                                                    </div>
                                                </div>
                                                {project.stats && (
                                                    <div class="flex items-start text-4xl leading-8 text-text-primary gap-2 w-full">
                                                        <div class="flex flex-col items-start font-medium gap-1 text-3xl w-full">
                                                            {
                                                                project.stats[0]
                                                                    .value
                                                            }
                                                            <span class="lowercase mono font-normal text-sm sm:text-base text-green-light">
                                                                {
                                                                    project
                                                                        .stats[0]
                                                                        .label
                                                                }
                                                            </span>
                                                        </div>
                                                        <div class="flex flex-col items-start font-medium gap-1 text-3xl w-full">
                                                            {
                                                                project.stats[1]
                                                                    .value
                                                            }
                                                            <span class="lowercase mono font-normal text-sm sm:text-base text-yellow-light">
                                                                {
                                                                    project
                                                                        .stats[1]
                                                                        .label
                                                                }
                                                            </span>
                                                        </div>
                                                    </div>
                                                )}
                                            </div>
                                        </div>
                                        <button class="cs-btn">
                                            View Case Study
                                            <div class="flex items-center justify-center w-8 h-8">
                                                <svg
                                                    class="cs-arrow w-6"
                                                    viewBox="0 0 28 14"
                                                    fill="none"
                                                    xmlns="http://www.w3.org/2000/svg"
                                                >
                                                    <path
                                                        d="M20.7771 14L19.201 12.5388L23.839 8.0449L9.02452e-07 8.0449V5.9551L23.839 5.9551L19.201 1.46122L20.7771 -3.15721e-07L28 7L20.7771 14Z"
                                                        fill="currentColor"
                                                    />
                                                </svg>
                                            </div>
                                        </button>
                                    </div>
                                    {/* Image Side */}
                                    <div class="flex overflow-hidden w-full aspect-4/3">
                                        <img
                                            src={project.image}
                                            alt={project.title}
                                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                                        />
                                    </div>
                                </div>
                                <div
                                    aria-label="Project Scope"
                                    class="scope-carousel-container py-4"
                                >
                                    <div
                                        class="scope-carousel-track justify-center-center items-center"
                                        data-duplicates={minDuplicates}
                                    >
                                        {duplicatedScope.map((item, idx) => (
                                            <>
                                                <span class="scope-item text-base font-normal text-text-secondary px-5 py-2.5 rounded-full border border-stroke-weak-dark">
                                                    {item}
                                                </span>
                                                {/* Add separator after each complete set */}
                                                {(idx + 1) %
                                                    project.scope.length ===
                                                    0 &&
                                                    idx !==
                                                        duplicatedScope.length -
                                                            1 && (
                                                        <div class="scope-separator shrink-0 text-xl text-text-secondary flex pt-2 px-2 h-5 justify-center-center items-center mono">
                                                            *
                                                        </div>
                                                    )}
                                            </>
                                        ))}
                                    </div>
                                </div>
                            </a>
                        </div>

                        {/* Grid Separator - Only between cards, not after last one */}
                        {index < projects.length - 1 && (
                            <div class="flex border-x border-stroke-weak-dark w-full max-w-7xl h-12 sm:h-16 lg:h-24 mx-auto" />
                        )}
                    </>
                );
            })
        }
    </div>
</section>

<script>
    const scopeTracks = document.querySelectorAll(".scope-carousel-track");

    scopeTracks.forEach((track) => {
        const container = track.parentElement;
        if (!container) return;

        const duplicates = parseInt(
            (track as HTMLElement).getAttribute("data-duplicates") || "3",
        );
        const isMobile = window.innerWidth < 768;

        let position = 0;
        let animationFrame: number;

        const getItemCount = () => {
            return (
                (track as HTMLElement).querySelectorAll(".scope-item").length /
                duplicates
            );
        };

        const lerp = (start: number, end: number, factor: number) => {
            return start + (end - start) * factor;
        };

        // ========== MOBILE VERSION ==========
        if (isMobile) {
            // Ensure container is scrollable
            container.style.display = "block";
            container.style.overflowX = "scroll";
            container.style.webkitOverflowScrolling = "touch";

            (track as HTMLElement).style.display = "flex";
            (track as HTMLElement).style.width = "max-content";

            let lastScrollPos = 0;
            let userScrolling = false;
            let isAutoScrolling = true;
            let accumulatedScroll = 0;
            const scrollSpeed = 0.3;

            const getResetPoint = () => {
                const itemCount = getItemCount();
                const items = Array.from(
                    (track as HTMLElement).querySelectorAll(".scope-item"),
                );
                const separators = Array.from(
                    (track as HTMLElement).querySelectorAll(".scope-separator"),
                );

                let width = 0;
                for (let i = 0; i < itemCount; i++) {
                    const item = items[i] as HTMLElement;
                    width += item.offsetWidth + 8;
                }

                if (separators.length > 0) {
                    const sep = separators[0] as HTMLElement;
                    width += sep.offsetWidth + 8;
                }

                return width;
            };

            const animateMobile = () => {
                if (isAutoScrolling && !userScrolling) {
                    accumulatedScroll += scrollSpeed;

                    if (accumulatedScroll >= 1) {
                        const scrollAmount = Math.floor(accumulatedScroll);
                        container.scrollLeft += scrollAmount;
                        accumulatedScroll -= scrollAmount;
                    }

                    const resetPoint = getResetPoint();

                    if (resetPoint > 0 && container.scrollLeft >= resetPoint) {
                        container.scrollLeft =
                            container.scrollLeft - resetPoint;
                        lastScrollPos = container.scrollLeft;
                    }
                }

                animationFrame = requestAnimationFrame(animateMobile);
            };

            let scrollTimer: number;
            container.addEventListener("scroll", () => {
                const delta = Math.abs(container.scrollLeft - lastScrollPos);

                if (delta > 2) {
                    userScrolling = true;
                    isAutoScrolling = false;
                    accumulatedScroll = 0;
                }

                lastScrollPos = container.scrollLeft;

                clearTimeout(scrollTimer);
                scrollTimer = window.setTimeout(() => {
                    userScrolling = false;
                    isAutoScrolling = true;
                }, 10000);
            });

            setTimeout(() => {
                console.log("Starting scope carousel animation");
                animateMobile();
            }, 200);
        }
        // ========== DESKTOP VERSION ==========
        else {
            let baseSpeed = 0.3;
            let currentSpeed = baseSpeed;
            let targetSpeed = baseSpeed;

            const getTrackWidth = () => {
                const itemCount = getItemCount();
                const items = Array.from(
                    (track as HTMLElement).querySelectorAll(".scope-item"),
                );
                const separators = Array.from(
                    (track as HTMLElement).querySelectorAll(".scope-separator"),
                );

                let width = 0;
                for (let i = 0; i < itemCount; i++) {
                    const item = items[i] as HTMLElement;
                    width += item.offsetWidth + 8;
                }

                if (separators.length > 0) {
                    const sep = separators[0] as HTMLElement;
                    width += sep.offsetWidth + 8;
                }

                return width;
            };

            const animateDesktop = () => {
                currentSpeed = lerp(currentSpeed, targetSpeed, 0.05);
                position -= currentSpeed;

                const trackWidth = getTrackWidth();
                if (trackWidth > 0 && Math.abs(position) >= trackWidth) {
                    position = 0;
                }

                (track as HTMLElement).style.transform =
                    `translateX(${position}px)`;
                animationFrame = requestAnimationFrame(animateDesktop);
            };

            container.addEventListener("mouseenter", () => {
                targetSpeed = baseSpeed * 0.4;
            });

            container.addEventListener("mouseleave", () => {
                targetSpeed = baseSpeed;
            });

            animateDesktop();
        }

        window.addEventListener("beforeunload", () => {
            cancelAnimationFrame(animationFrame);
        });
    });
</script>
