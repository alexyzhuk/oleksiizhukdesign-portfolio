---
const currentYear = new Date().getFullYear();
---

<footer
    class="flex border-y border-stroke-weak-dark transtion-all duration-500 relative justify-center"
>
    <div
        class="max-w-7xl mx-auto w-full flex justify-between items-center border-x border-stroke-weak-dark sm:gap-5"
    >
        <!-- Logo -->
        <a
            href="/"
            class="flex items-center p-4.75 justify-between shrink-0"
            aria-label="Home"
        >
            <img src="/main-logo.svg" alt="Oleksii Zhuk" class="h-7 sm:h-8" />
        </a>

        <!-- Copyright -->
        <p
            class="w-fit text-sm sm:text-base items-center py-5.75 pr-5.75 text-center text-ellipsis sm:text-nowrap"
        >
            © {currentYear} Oleksii Zhuk. All Rights Reserved.
        </p>
    </div>
</footer>
