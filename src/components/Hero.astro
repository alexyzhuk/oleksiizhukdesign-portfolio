---
const tools = [
    {
        name: "Figma",
        description:
            "My multi-tool for getting things done. I use it for design and beyond.",
        icon: "/figma.svg",
    },
    {
        name: "Google Meet",
        description: "Instant communications & conferencing for agenda.",
        icon: "/googlemeet.svg",
    },
    {
        name: "Tally",
        description:
            "Modern style and simplistic setup make it a perfect assets for user research.",
        icon: "/tally.svg",
    },
    {
        name: "Claude",
        description: "Personal assistant that takes care of tedious tasks.",
        icon: "/claude.svg",
    },
    {
        name: "Astro",
        description:
            "Great framework for building lightning-fast websites and apps.",
        icon: "/astro.svg",
    },
    {
        name: "GitHub",
        description:
            "Primary service for task and project management. Pet projects repository for collaboration.",
        icon: "/github.svg",
    },
    {
        name: "Framer",
        description:
            "Dynamic website builder to build anything from landing pages to large websites.",
        icon: "/framer.svg",
    },
    {
        name: "Wordpress",
        description:
            "I redesign and update old websites, if a client doesn't want to switch platforms.",
        icon: "/wordpress.svg",
    },
    {
        name: "Zed",
        description:
            "Yes, I code! This is the code editor of my choice for Front-End Development.",
        icon: "/zed.png",
    },
    {
        name: "Affinity",
        description:
            "Photos, images, vectors, printables — this is the workbench for any task at hand.",
        icon: "/affinity.svg",
    },
    {
        name: "Final Cut Pro",
        description: "All things video for social media, presentations etc.",
        icon: "/finalcutpro.png",
    },
    {
        name: "Logic Pro",
        description:
            "I create unique sound effects for UI and videos to enhance product image.",
        icon: "/logicpro.png",
    },
    {
        name: "Nucleo",
        description:
            "Primary tool for icon set version management and icon font generation.",
        icon: "/nucleo.svg",
    },
];

const duplicatedTools = [...tools, ...tools, ...tools];
const calendlyLink = "https://calendly.com/alexy-zhuk/30min";
---

<section
    class="min-h-[90vh] sm:min-h-screen flex flex-col items-center justify-center sm:-mt-32 sm:pt-32 relative z-10 border-b border-stroke-weak-dark"
>
    <div
        class="max-w-7xl w-full h-full flex flex-col gap-6 px-4 sm:px-6 p-12 border border-t-0 border-stroke-weak-dark justify-center grow"
    >
        <p class="mono text-stroke-weak sm:text-2xl font-light text-balance">
            Hi! I'm Oleksii Zhuk, <br />a Product Designer & Developer.
        </p>

        <h1
            class="text-4xl sm:text-6xl leading-tight w-full sm:max-w-[25ch] text-balance md:text-wrap"
        >
            I <span class="italic text-blue-light">dive deep</span> into the root
            of a problem and create solutions
            <span class="italic text-yellow-light">not just for users</span>,
            but <span class="italic text-green-light">with them</span>.
        </h1>

        <div class="flex gap-2 items-center">
            <a
                href={calendlyLink}
                target="_blank"
                rel="noopener noreferrer"
                class="light-btn"
            >
                Book a Meeting
            </a>
            <a
                href="https://www.linkedin.com/in/oleksii-zhuk/"
                class="flex
            h-14 w-14 justify-center items-center p-4 rounded-2xl hover:bg-bg-light/10 transition-background duration-300"
            >
                <img src="/linkedin-logo.svg" class="w-5 h-5" />
            </a>
        </div>
    </div>
    <!-- Tools Carousel -->
    <div
        class="max-w-7xl w-full h-full flex flex-col pt-2 sm:pb-4 border-x border-stroke-weak-dark justify-center"
    >
        <div class="w-full px-4 sm:px-6">
            <p class="mt-2 m:my-4 mono text-start sm:text-lg font-light">
                Tools I Use Daily
            </p>
        </div>

        <div class="carousel-container">
            <div class="carousel-track" id="carousel-track">
                {
                    duplicatedTools.map((tool) => (
                        <div class="tool-item">
                            <img
                                src={tool.icon}
                                alt={tool.name}
                                class="tool-icon"
                                data-tool-name={tool.name}
                                data-tool-description={tool.description}
                            />
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Custom Tooltip -->
        <div
            id="tool-tooltip"
            class="fixed w-54 text-balance z-10000 px-5 py-4 bg-bg-dark border border-stroke-weak-dark rounded-xl shadow-lg pointer-events-none max-w-75 opacity-0 transition-opacity duration-500 invisible"
        >
            <p class="text-base font-medium mb-1" id="tooltip-name"></p>
            <p
                class="text-sm text-stroke-weak leading-6"
                id="tooltip-description"
            >
            </p>
        </div>
    </div>
</section>

<script>
    const track = document.getElementById("carousel-track") as HTMLElement;
    const carouselContainer = document.querySelector(
        ".carousel-container",
    ) as HTMLElement;
    const tooltip = document.getElementById("tool-tooltip");
    const tooltipName = document.getElementById("tooltip-name");
    const tooltipDescription = document.getElementById("tooltip-description");

    const isMobile = window.innerWidth < 768;
    let position = 0;
    let animationFrame: number;
    let mouseX = 0;
    let mouseY = 0;
    let currentHoveredIcon: Element | null = null;
    let hideTimeout: number | null = null;

    const getTrackWidth = () => {
        if (!track) return 0;
        return track.scrollWidth / 3;
    };

    const lerp = (start: number, end: number, factor: number) => {
        return start + (end - start) * factor;
    };

    // Check which icon is under cursor
    const checkIconUnderCursor = () => {
        const element = document.elementFromPoint(mouseX, mouseY);
        const icon = element?.closest(".tool-icon") as HTMLElement;

        if (icon && icon !== currentHoveredIcon) {
            currentHoveredIcon = icon;
            showTooltip(icon);
        } else if (!icon && currentHoveredIcon) {
            currentHoveredIcon = null;
            hideTooltip();
        }
    };

    const showTooltip = (icon: HTMLElement) => {
        if (hideTimeout) {
            clearTimeout(hideTimeout);
            hideTimeout = null;
        }

        const name = icon.getAttribute("data-tool-name");
        const description = icon.getAttribute("data-tool-description");

        if (
            tooltipName &&
            tooltipDescription &&
            name &&
            description &&
            tooltip
        ) {
            tooltipName.textContent = name;
            tooltipDescription.textContent = description;
            tooltip.classList.remove("invisible");
            requestAnimationFrame(() => {
                tooltip?.classList.remove("opacity-0");
                tooltip?.classList.add("opacity-100");
            });
        }
    };

    const hideTooltip = () => {
        tooltip?.classList.remove("opacity-100");
        tooltip?.classList.add("opacity-0");

        hideTimeout = window.setTimeout(() => {
            tooltip?.classList.add("invisible");
        }, 500);
    };

    // ========== MOBILE VERSION ==========
    if (isMobile && carouselContainer) {
        carouselContainer.style.overflowX = "scroll";
        carouselContainer.style.webkitOverflowScrolling = "touch";

        let lastScrollPos = 0;
        let userScrolling = false;
        let isAutoScrolling = true;

        const animateMobile = () => {
            if (isAutoScrolling && !userScrolling) {
                carouselContainer.scrollLeft += 1;

                const resetPoint = getTrackWidth();
                if (carouselContainer.scrollLeft >= resetPoint) {
                    carouselContainer.scrollLeft -= resetPoint;
                    lastScrollPos = carouselContainer.scrollLeft;
                }
            }

            animationFrame = requestAnimationFrame(animateMobile);
        };

        let scrollTimer: number;
        carouselContainer.addEventListener("scroll", () => {
            const delta = Math.abs(
                carouselContainer.scrollLeft - lastScrollPos,
            );

            if (delta > 2) {
                userScrolling = true;
                isAutoScrolling = false;
            }

            lastScrollPos = carouselContainer.scrollLeft;

            clearTimeout(scrollTimer);
            scrollTimer = window.setTimeout(() => {
                userScrolling = false;
                isAutoScrolling = true;
            }, 10000); // Resume after 10 seconds
        });

        animateMobile();
    }
    // ========== DESKTOP VERSION ==========
    else if (!isMobile && track) {
        let baseSpeed = 0.3;
        let currentSpeed = baseSpeed;
        let targetSpeed = baseSpeed;
        let isHovering = false;

        const animateDesktop = () => {
            currentSpeed = lerp(currentSpeed, targetSpeed, 0.05);
            position -= currentSpeed;

            const trackWidth = getTrackWidth();
            if (Math.abs(position) >= trackWidth) {
                position = 0;
            }

            track.style.transform = `translateX(${position}px)`;

            if (isHovering) {
                checkIconUnderCursor();
            }

            animationFrame = requestAnimationFrame(animateDesktop);
        };

        document.addEventListener("mousemove", (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;

            if (tooltip && currentHoveredIcon) {
                tooltip.style.left = e.clientX + 20 + "px";
                tooltip.style.top = e.clientY + 20 + "px";
            }
        });

        carouselContainer?.addEventListener("mouseenter", () => {
            isHovering = true;
            targetSpeed = baseSpeed * 0.2;
        });

        carouselContainer?.addEventListener("mouseleave", () => {
            isHovering = false;
            targetSpeed = baseSpeed;
            currentHoveredIcon = null;
            hideTooltip();
        });

        animateDesktop();
    }

    window.addEventListener("beforeunload", () => {
        cancelAnimationFrame(animationFrame);
    });
</script>
