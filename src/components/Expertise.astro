---
const expertise = [
    {
        number: "01",
        title: "Product Designer",
        tabColor: "border-blue-light",
        skills: [
            "Research",
            "User Testing",
            "Usability Testing",
            "Problem Discovery",
            "Design Systems",
            "Accessibility",
            "Competitive Audit",
            "Mentorship",
            "Prototyping",
            "Product Strategy",
            "IA",
            "Interaction Design",
        ],
    },
    {
        number: "02",
        title: "Brand Designer",
        tabColor: "border-yellow-light",
        skills: [
            "Brand Kit",
            "Logo Design",
            "Tone of Voice",
            "Brand Identity",
            "Mockups",
            "Merch Design",
            "Outdoor Branding",
            "Presentation Design",
            "Typography",
            "Multi-branding",
            "E-Business Cards",
            "Event Branding",
        ],
    },
    {
        number: "03",
        title: "Graphic Designer",
        tabColor: "border-green-light",
        skills: [
            "Iconography",
            "Pictograms",
            "Illustration",
            "Presentation Assets",
            "Book Illustration",
            "Color Psychology",
            "Visual Design",
            "Visual Consistency",
            "Data Visualization",
            "Creative Marketing",
            "Vector Animation",
            "AI Artwork",
        ],
    },
    {
        number: "04",
        title: "Front-End Developer",
        tabColor: "border-red-light",
        skills: [
            "HTML",
            "CSS",
            "JavaScript",
            "TypeScript",
            "PHP",
            "Astro",
            "React",
            "Wordpress",
