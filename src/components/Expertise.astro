---
const expertise = [
    {
        number: "01",
        title: "Product Designer",
        accent: "text-blue-light",
        skills: [
            "Research",
            "User Testing",
            "Usability Testing",
            "Problem Discovery",
            "Design Systems",
            "Accessibility",
            "Competitive Audit",
            "Mentorship",
            "Prototyping",
            "Product Strategy",
            "IA",
            "Interaction Design",
        ],
    },
    {
        number: "02",
        title: "Front-End Developer",
        accent: "text-green-light",
        // Order pairs the two-line labels into shared rows of the 2-col
        // mobile grid, so no row has one tall cell next to a short one.
        skills: [
            "HTML & CSS",
            "JavaScript",
            "TypeScript",
            "React",
            "Astro",
            "Laravel",
            "API Integration",
            "CI/CD",
            "Component Architecture",
            "Design Systems in Code",
            "Motion & Animation",
            "Accessibility (WCAG)",
            "SEO & Structured Data",
            // Forced break keeps the long word on its own line in the 2-col
            // mobile grid; the wider desktop grid fits it on one line.
            "Internationalization <br class='lg:hidden' />(i18n)",
            "Core Web Vitals",
            "Headless CMS",
            "Framer",
            "Wix",
        ],
    },
    {
        number: "03",
        title: "Brand Designer",
        accent: "text-yellow-light",
        skills: [
            "Brand Kit",
            "Logo Design",
            "Tone of Voice",
            "Brand Identity",
            "Mockups",
            "Merch Design",
            "Outdoor Branding",
            "Presentation Design",
            "Typography",
            "Multi-branding",
            "E-Business Cards",
            "Event Branding",
        ],
    },
    {
        number: "04",
        title: "Graphic Designer",
        accent: "text-red-light",
        skills: [
            "Iconography",
            "Pictograms",
            "Illustration",
            "Presentation Assets",
            "Book Illustration",
            "Color Psychology",
            "Visual Design",
            "Visual Consistency",
            "Data Visualization",
            "Creative Marketing",
            "Vector Animation",
            "AI Artwork",
        ],
    },
];
---

<section
    id="expertise"
    class="min-h-fit w-full flex flex-col items-center justify-center z-10 sm:border-b border-b-stroke-weak-dark"
>
    <div
        class="w-full max-w-7xl flex flex-col pt-12 sm:py-24 gap-8 border-x border-stroke-weak-dark"
    >
        {/* Section Header — the role name is the selector */}
        <div
            class="flex items-center justify-between gap-2 px-4 sm:px-6 sm:gap-8"
        >
            <h2
                class="text-3xl sm:text-5xl font-medium leading-10 sm:leading-normal"
            >
                Hire me as <span class="role-name-mask"
                    ><span id="role-name" class="text-blue-light"
                        >{expertise[0].title}</span
                    ></span
                >
            </h2>

            <div class="flex self-end sm:items-center gap-2 shrink-0">
                <button
                    id="role-prev"
                    type="button"
                    class="role-nav-btn"
                    aria-label="Previous role"
                >
                    <svg
                        class="size-5 sm:size-7 rotate-180"
                        viewBox="0 0 20 20"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M5 8L10 13L15 8"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </button>

                <button
                    id="role-next"
                    type="button"
                    class="role-nav-btn"
                    aria-label="Next role"
                >
                    <svg
                        class="size-5 sm:size-7"
                        viewBox="0 0 20 20"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M5 8L10 13L15 8"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </button>
            </div>
        </div>

        {/* Full-width Skills Grid */}
        <div class="w-full">
            {
                expertise.map((category, index) => (
                    <div
                        class={`expertise-content ${index === 0 ? "" : "hidden"}`}
                        data-content-index={index}
                        data-title={category.title}
                        data-accent={category.accent}
                    >
                        <div class="border-t border-stroke-weak-dark">
                            <ul class="grid grid-cols-2 lg:grid-cols-3">
                                {category.skills.map((skill, skillIndex) => (
                                    <li
                                        class="skill-item text-lg sm:text-xl text-text-secondary hover:text-text-primary hover:bg-bg-plaque transition-all duration-300 tracking-tight p-4 sm:px-6 sm:py-5 border-l border-b border-stroke-weak-dark break-words"
                                        data-skill-index={skillIndex}
                                        set:html={skill}
                                    />
                                ))}
                            </ul>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    /* 2-col mobile grid: first column sits on the section edge, no left border */
    @media (width < 48rem) {
        .skill-item:nth-child(2n + 1) {
            border-left: 0;
        }
    }

    /* Role name rolls upward: old title exits through the top, new one
       enters from below. Padding/margin pair keeps descenders unclipped. */
    .role-name-mask {
        display: inline-block;
        overflow: hidden;
        vertical-align: bottom;
        padding-bottom: 0.12em;
        margin-bottom: -0.12em;
    }

    #role-name {
        display: inline-block;
        will-change: transform;
    }

    .role-roll-out {
        animation: role-roll-out 0.26s cubic-bezier(0.4, 0, 1, 1) forwards;
    }

    .role-roll-in {
        animation: role-roll-in 0.32s cubic-bezier(0, 0, 0.2, 1);
    }

    @keyframes role-roll-out {
        to {
            transform: translateY(-100%);
            opacity: 0;
        }
    }

    @keyframes role-roll-in {
        from {
            transform: translateY(100%);
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .role-roll-out,
        .role-roll-in {
            animation: none;
        }
    }
</style>

<script>
    const contents = document.querySelectorAll(".expertise-content");
    const section = document.querySelector("#expertise");
    const roleName = document.getElementById("role-name");
    const prevBtn = document.getElementById("role-prev");
    const nextBtn = document.getElementById("role-next");
    let hasAnimated = false;

    // Accent classes come from the markup so the data stays in one place
    const accents = Array.from(contents)
        .map((c) => c.getAttribute("data-accent"))
        .filter(Boolean);

    let activeIndex = 0;

    // Function to animate skills
    function animateSkills(container) {
        const skills = container.querySelectorAll(".skill-item");

        // Reset animation state
        skills.forEach((skill) => {
            skill.classList.remove("skill-visible");
        });

        // Trigger animation with stagger
        skills.forEach((skill, index) => {
            setTimeout(() => {
                skill.classList.add("skill-visible");
            }, index * 50); // 50ms delay between each skill
        });
    }

    // Half the roll: title exits upward, then everything swaps and the new
    // title enters from below.
    const ROLL_OUT_MS = 260;
    let swapTimer = null;

    function paintRole(index) {
        contents.forEach((content, i) => {
            content.classList.toggle("hidden", i !== index);
        });

        if (roleName) {
            roleName.textContent =
                contents[index].getAttribute("data-title") ?? "";
            roleName.classList.remove(...accents);
            if (accents[index]) {
                roleName.classList.add(accents[index]);
            }
        }

        animateSkills(contents[index]);
    }

    function selectRole(index) {
        if (index === activeIndex) return;
        activeIndex = index;

        if (!roleName) {
            paintRole(index);
            return;
        }

        if (swapTimer !== null) clearTimeout(swapTimer);

        roleName.classList.remove("role-roll-in");
        roleName.classList.add("role-roll-out");

        swapTimer = window.setTimeout(() => {
            paintRole(index);
            roleName.classList.remove("role-roll-out");
            roleName.classList.add("role-roll-in");
            swapTimer = null;
        }, ROLL_OUT_MS);
    }

    // Auto-switch until the visitor steps through the roles themselves
    const AUTO_SWITCH_DELAY = 7000;
    let autoTimer = null;
    let isVisible = false;
    let userInteracted = false;

    function stopAutoSwitch() {
        if (autoTimer !== null) {
            clearInterval(autoTimer);
            autoTimer = null;
        }
    }

    function startAutoSwitch() {
        stopAutoSwitch();
        if (userInteracted || !isVisible) return;
        autoTimer = window.setInterval(() => {
            selectRole((activeIndex + 1) % contents.length);
        }, AUTO_SWITCH_DELAY);
    }

    function step(direction) {
        userInteracted = true;
        stopAutoSwitch();
        selectRole(
            (activeIndex + direction + contents.length) % contents.length,
        );
    }

    prevBtn?.addEventListener("click", () => step(-1));
    nextBtn?.addEventListener("click", () => step(1));

    // Intersection Observer: first-scroll animation + auto-switch gating
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                isVisible = entry.isIntersecting;

                if (entry.isIntersecting && !hasAnimated) {
                    hasAnimated = true;
                    animateSkills(contents[activeIndex]);
                }

                if (isVisible) {
                    startAutoSwitch();
                } else {
                    stopAutoSwitch();
                }
            });
        },
        {
            threshold: 0.2,
        },
    );

    if (section) {
        observer.observe(section);
    }
</script>
