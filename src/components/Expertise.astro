---

<section
    id="expertise"
    class="min-h-fit w-full flex flex-col items-center justify-center z-10 sm:border-b border-b-stroke-weak-dark"
>
    <div
        class="w-full max-w-7xl flex flex-col pt-12 sm:py-24 gap-8 border-x border-stroke-weak-dark"
    >
        {/* Section Header */}
        <h2 class="text-4xl sm:text-5xl px-4 sm:px-6 font-medium">
            Hire me as
        </h2>

        {/* Tab Layout */}
        <div class="flex flex-col md:flex-row gap-6">
            {/* Left: Role Tabs */}
            <div class="flex flex-col gap-0 lg:min-w-md">
                {
                    expertise.map((category, index) => (
                        <button
                            class={`expertise-tab h-full md:max-h-60 lg:max-h-full py-3 px-4 sm:px-6 border-l-3 text-left font-medium tracking-tight text-2xl lg:text-3xl transition-all duration-300 cursor-pointer ${
                                index === 0
                                    ? `text-text-primary ${category.tabColor}`
                                    : "text-text-secondary-inverse border-transparent"
                            } hover:text-text-primary`}
                            data-index={index}
                            data-color={category.tabColor}
                        >
                            {category.title}
                        </button>
                    ))
                }
            </div>

            {/* Right: Skills Grid */}
            <div class="flex-1 h-full">
                {
                    expertise.map((category, index) => (
                        <div
                            class={`expertise-content ${index === 0 ? "" : "hidden"}`}
                            data-content-index={index}
                        >
                            <div class="border-t border-stroke-weak-dark">
                                <ul class="grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-3">
                                    {category.skills.map(
                                        (skill, skillIndex) => (
                                            <li
                                                class="skill-item text-lg sm:text-xl text-text-secondary hover:text-text-primary hover:bg-bg-plaque transition-all duration-300 tracking-tight p-4 sm:px-6 sm:py-5 xs:border-l border-b border-stroke-weak-dark"
                                                data-skill-index={skillIndex}
                                            >
                                                {skill}
                                            </li>
                                        ),
                                    )}
                                </ul>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<script>
    const tabs = document.querySelectorAll(".expertise-tab");
    const contents = document.querySelectorAll(".expertise-content");
    const section = document.querySelector("#expertise");
    let hasAnimated = false;

    // Function to animate skills
    function animateSkills(container) {
        const skills = container.querySelectorAll(".skill-item");

        // Reset animation state
        skills.forEach((skill) => {
            skill.classList.remove("skill-visible");
        });

        // Trigger animation with stagger
        skills.forEach((skill, index) => {
            setTimeout(() => {
                skill.classList.add("skill-visible");
            }, index * 50); // 50ms delay between each skill
        });
    }

    // Intersection Observer for initial scroll animation
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting && !hasAnimated) {
                    hasAnimated = true;
                    const activeContent = document.querySelector(
                        ".expertise-content:not(.hidden)",
                    );
                    if (activeContent) {
                        animateSkills(activeContent);
                    }
                }
            });
        },
        {
            threshold: 0.2,
        },
    );

    if (section) {
        observer.observe(section);
    }

    // Tab switching
    tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
            const index = tab.getAttribute("data-index");
            const color = tab.getAttribute("data-color");

            // Update tab styles
            tabs.forEach((t) => {
                t.classList.remove(
                    "text-text-primary",
                    "border-blue-light",
                    "border-yellow-light",
                    "border-green-light",
                    "border-red-light",
                );
                t.classList.add(
                    "text-text-secondary-inverse",
                    "border-transparent",
                );
            });
            tab.classList.remove(
                "text-text-secondary-inverse",
                "border-transparent",
            );
            tab.classList.add("text-text-primary", color);

            // Update content visibility
            contents.forEach((content) => {
                content.classList.add("hidden");
            });
            const activeContent = document.querySelector(
                `[data-content-index="${index}"]`,
            );
            activeContent?.classList.remove("hidden");

            // Animate skills when switching tabs
            if (activeContent) {
                animateSkills(activeContent);
            }
        });
    });
</script>
