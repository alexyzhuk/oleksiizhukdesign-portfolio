---
import { INQUIRY_URL } from "../consts";

const services = [
    {
        number: "01",
        tag: "design",
        title: "UX/UI Design",
        accent: "text-blue-light",
        tab: "bg-blue-light",
        oneLiner:
            "Research-driven product and interface design that turns a fuzzy idea into a validated, developer-ready design system.",
        deliverables: [
            "User research & testing",
            "Information architecture",
            "Wireframes & prototypes",
            "UI design",
            "Design systems",
            "Accessibility (WCAG)",
        ],
        idealFor:
            "Startups and teams that need a senior product designer to shape a product from discovery to a polished, buildable UI.",
        engagement: "Project-based or monthly retainer",
        cta: "Discuss a design project",
    },
    {
        number: "02",
        tag: "development",
        title: "Web Development",
        accent: "text-green-light",
        tab: "bg-green-light",
        oneLiner:
            "Custom, fast, accessible websites and front-ends — hand-built in modern frameworks, not dragged together from a template.",
        deliverables: [
            "Astro / React builds",
            "Headless CMS integration",
            "Motion & interaction",
            "SEO & structured data",
            "Core Web Vitals / performance",
            "Deployment & handoff",
        ],
        idealFor:
            "Founders and businesses that want a bespoke site or web app that loads instantly and ranks well — built by the same person who designed it.",
        engagement: "Project-based or monthly retainer",
        cta: "Discuss a development project",
    },
];
---

<section
    id="services"
    class="w-full flex flex-col items-center justify-center z-10"
>
    <!-- Section Header -->
    <div
        class="w-full max-w-7xl flex flex-col pt-12 sm:pt-24 pb-8 gap-8 px-4 sm:px-6 border-x border-stroke-weak-dark"
    >
        <h2 class="text-4xl sm:text-5xl font-medium">Services</h2>
        <p
            class="sm:text-lg text-balance leading-loose text-text-secondary max-w-[64ch]"
        >
            Two disciplines, one collaborator. Hire me for either — or both, end
            to end, with no handoff gap in between.
        </p>
    </div>

    <!-- Service Cards -->
    <div
        class="w-full flex flex-col items-center border-t border-stroke-weak-dark"
    >
        <div
            class="w-full max-w-7xl grid grid-cols-1 lg:grid-cols-2 border-x border-stroke-weak-dark"
        >
            {
                services.map((service, i) => (
                    <div
                        class={`method-card flex flex-col gap-8 p-6 sm:p-10 border-stroke-weak-dark ${
                            i === 0
                                ? "border-b lg:border-b-0 lg:border-r"
                                : ""
                        }`}
                    >
                        {/* Accent tab */}
                        <div class={`h-1 w-12 rounded-full ${service.tab}`} />

                        {/* Heading */}
                        <div class="flex flex-col gap-4">
                            <span class={`mono text-sm lowercase ${service.accent}`}>
                                {service.number} / {service.tag}
                            </span>
                            <h3 class="text-3xl sm:text-4xl">{service.title}</h3>
                            <p class="text-base sm:text-lg text-text-secondary leading-8 text-balance">
                                {service.oneLiner}
                            </p>
                        </div>

                        {/* Deliverables */}
                        <div class="flex flex-col gap-4">
                            <span class="mono text-sm lowercase text-text-secondary">
                                what you get
                            </span>
                            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
                                {service.deliverables.map((item) => (
                                    <li class="flex items-center gap-3">
                                        <img
                                            src="/check.svg"
                                            alt=""
                                            class="w-3 h-3 shrink-0"
                                        />
                                        <span class="text-base text-text-primary">
                                            {item}
                                        </span>
                                    </li>
                                ))}
                            </ul>
                        </div>

                        {/* Ideal for */}
                        <div class="flex flex-col gap-2 mt-auto">
                            <span class="mono text-sm lowercase text-text-secondary">
                                ideal for
                            </span>
                            <p class="text-base text-text-secondary leading-7">
                                {service.idealFor}
                            </p>
                        </div>

                        {/* Engagement + CTA */}
                        <div class="flex flex-col gap-6">
                            <span class="mono text-sm text-text-secondary">
                                {service.engagement}
                            </span>
                            <a
                                href={INQUIRY_URL}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="light-btn w-full sm:w-fit flex"
                            >
                                {service.cta}
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
