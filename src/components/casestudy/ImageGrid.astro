---
interface Props {
    images: string[];
    columns?: number;
}

const { images, columns = 3 } = Astro.props;
const gridClass = columns === 2 ? "md:grid-cols-2" : "md:grid-cols-3";
---

<section class="px-6 py-16">
    <div class="max-w-6xl mx-auto">
        <div class={`grid grid-cols-1 ${gridClass} gap-8`}>
            {
                images.map((image) => (
                    <img
                        src={image}
                        alt="Product screenshot"
                        class="w-full rounded-lg"
                    />
                ))
            }
        </div>
    </div>
</section>
