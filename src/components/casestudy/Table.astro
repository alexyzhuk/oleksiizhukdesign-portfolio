---
interface Column {
    header?: string;
    key: string;
    width?: string;
}
interface Props {
    columns: Column[];
    data: Record<string, string>[];
}
const { columns, data } = Astro.props;
---

<div class="overflow-x-auto">
    <table class="w-full border-collapse">
        <tbody
            class="flex flex-col gap-4 sm:gap-0 border-t border-stroke-weak-dark"
        >
            {
                data.map((row, index) => (
                    <tr class="flex flex-col sm:flex-row border-b border-stroke-weak-dark">
                        {columns.map((column, colIndex) => (
                            <td
                                class={`py-3 sm:py-4.5 px-4 sm:px-6 text-base bg-table-tint tracking-[-0.03em] leading-relaxed ${column.width || ""} ${colIndex === 0 ? "border-b border-stroke-medium sm:border-none sm:w-2/5 text-text-primary shrink-0 font-medium" : "flex-1 text-text-secondary"}`}
                            >
                                {row[column.key]}
                            </td>
                        ))}
                    </tr>
                ))
            }
        </tbody>
    </table>
</div>
