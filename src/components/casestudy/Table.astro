---
interface Column {
    header?: string;
    key: string;
    width?: string;
}
interface Props {
    columns: Column[];
    data: Record<string, string>[];
}
const { columns, data } = Astro.props;
---

<div class="max-w-200 mx-auto">
    <div class="overflow-x-auto">
        <table class="w-full border-collapse">
            <tbody class="flex flex-col gap-0.75">
                {
                    data.map((row, index) => (
                        <tr class="flex gap-0.75">
                            {columns.map((column, colIndex) => (
                                <td
                                    class={`py-4.5 px-6 text-base  bg-[#425b7d12] tracking-[-0.03em] leading-relaxed ${column.width || ""} ${colIndex === 0 ? "w-2/5 text-text-primary shrink-0 font-medium" : "flex-1 text-text-secondary"}`}
                                >
                                    {row[column.key]}
                                </td>
                            ))}
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </div>
</div>
