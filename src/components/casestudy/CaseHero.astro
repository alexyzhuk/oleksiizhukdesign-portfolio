---
interface Props {
    company: string;
    title: string;
    subtitle: string;
    coverImage: string;
    accentColor?: string;
    logo?: string;
}

const {
    company,
    title,
    subtitle,
    coverImage,
    logo,
    accentColor = "text-blue-light",
} = Astro.props;
---

<section
    class="flex flex-col items-center relative w-full h-135 z-0"
    style={`background-image: url(${coverImage}); background-size: cover; background-position: center;`}
>
    <div class="absolute gradient-hero flex w-full h-full z-0"></div>
    <div class="absolute bg-bg-dark/60 flex w-full h-full z-0"></div>
    <div class="flex px-6 py-16 w-full h-full items-center justify-center z-1">
        <div
            class="flex flex-col w-full h-full max-w-7xl justify-between items-center"
        >
            <!-- Back Button -->
            <div class="flex w-full items-start">
                <a href="/#selected-work" class="outline-btn w-fit"> ← Back </a>
            </div>
            <!-- Content -->
            <div class="flex flex-col w-full gap-8 max-w-200 mx-auto">
                <img src={logo} alt={title} class="w-32" />
                <h1 class="max-w-4xl">{title}</h1>
                <p
                    class="text-text-primary text-xl max-w-2xl leading-relaxed text-balance"
                >
                    {subtitle}
                </p>
            </div>
        </div>
    </div>
</section>
