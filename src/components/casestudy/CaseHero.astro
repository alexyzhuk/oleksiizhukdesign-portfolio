---
interface Props {
    company: string;
    title: string;
    subtitle: string;
    coverImage: string;
    accentColor?: string;
    logo?: string;
}

const {
    company,
    title,
    subtitle,
    coverImage,
    logo,
    accentColor = "text-blue-light",
} = Astro.props;
---

<section
    class="flex flex-col items-center relative w-full h-135 z-0"
    style={`background-image: url(${coverImage}); background-size: cover; background-position: center;`}
>
    <div class="absolute gradient-hero flex w-full h-full z-0"></div>
    <div class="absolute bg-bg-dark/60 flex left-0 top-0 right-0 z-5"></div>
</section>
