<style>
    .cs-ew-diagrams {
        --background: #0c0d13;
        --stroke-strong: #3b4b65;
        --icon-weak: #5b6b84;
        --icon-strong: #91a1bc;
        --text-strong: #ffffff;
        --accent-primary: #f4ff90;
        --ew-signal: #f4ff90;
        --ew-safe: #4ade80;
    }
    :global(.ew-label-uk) {
        display: none;
    }
    .cs-ew-panels {
        width: 75%;
        margin-inline: auto;
    }
:global(.anim-tabs) {
  background: transparent;
  border: 2px solid var(--accent-primary);
  border-radius: 1.5rem;
}

:global([data-theme="light"] .anim-tabs) {
  border-color: var(--text-strong);
}

:global(.anim-tab) {
  color: var(--accent-primary);
  border-radius: 9999px !important;
  transition: color 0.2s ease, background-color 0.2s ease;
}

:global([data-theme="light"] .anim-tab) {
  color: var(--text-strong);
}

:global(.anim-tab.tab-active) {
  background: var(--accent-primary) !important;
  color: var(--background) !important;
}

:global([data-theme="light"] .anim-tab.tab-active) {
  background: var(--text-strong) !important;
  color: var(--background) !important;
}

:global(.anim-panel) {
  transition: opacity 0.25s ease;
}

:global(.jam-path) { animation: ew-march 1.4s linear infinite; }

@keyframes jam-k-dev { 0%,49%{opacity:0} 50%,98%{opacity:0.9} 99%,100%{opacity:0} }

:global(.jam-dev) { animation: jam-k-dev 18s linear infinite, ew-march 1.2s linear infinite; }

:global(.jam-ant-tip) {
  transform-box: fill-box;
  transform-origin: center;
  animation: ew-k-ant 1.2s ease-in-out infinite;
}

:global(.jam-target) { opacity: 1; }

@keyframes jam-sl1 { 0%{opacity:1} 24%{opacity:1} 25%{opacity:0} 100%{opacity:0} }

@keyframes jam-sl2 { 0%,24%{opacity:0} 25%{opacity:1} 42%{opacity:1} 43%{opacity:0} 100%{opacity:0} }

@keyframes jam-sl3 { 0%,43%{opacity:0} 44%{opacity:1} 74%{opacity:1} 75%{opacity:0} 100%{opacity:0} }

@keyframes jam-sl4 { 0%,74%{opacity:0} 75%{opacity:1} 99%{opacity:1} 100%{opacity:0} }

:global(.jam-sl-1) { animation: jam-sl1 18s linear infinite; }

:global(.jam-sl-2) { animation: jam-sl2 18s linear infinite; }

:global(.jam-sl-3) { animation: jam-sl3 18s linear infinite; }

:global(.jam-sl-4) { animation: jam-sl4 18s linear infinite; }

:global(.cb-traj) { animation: ew-march 1.4s linear infinite; }

:global(.cb-ant-tip) {
  transform-box: fill-box;
  transform-origin: center;
  animation: ew-k-ant 1.2s ease-in-out infinite;
}

@keyframes cb-k-fall { 0%,39%{opacity:0} 40%,60%{opacity:0.6} 68%,100%{opacity:0} }

:global(.cb-fall-line) { animation: cb-k-fall 15s linear infinite; }

:global(.cb-target) { opacity: 1; }

:global(.ew-sat),

:global(.ew-sat-line) {
  color: var(--icon-weak);
}

:global([data-theme="light"] .ew-sat),

:global([data-theme="light"] .ew-sat-line) {
  color: var(--icon-strong);
}

:global([data-theme="light"] .device-connectors) {
  stroke: var(--text-strong);
  fill: none;
}

:global([data-theme="light"] .device-shape-outline) {
  stroke: var(--text-strong);
  fill: none;
}

:global([data-theme="light"] .device-fill) {
  fill: var(--accent-primary);
  stroke: none;
}

:global([data-theme="light"] .ew-device circle:not(.device-fill)),

:global([data-theme="light"] .jam-device circle:not(.device-fill)),

:global([data-theme="light"] .cb-device circle:not(.device-fill)) {
  stroke: none;
  fill: var(--accent-primary);
}

:global([data-theme="light"] .ew-device text),

:global([data-theme="light"] .jam-device text),

:global([data-theme="light"] .cb-device text) {
  fill: var(--text-strong);
}

:global([data-theme="light"] .ew-sig-line) {
  stroke: var(--text-strong);
}

:global([data-theme="light"] .ew-sl text),

:global([data-theme="light"] .jam-sl text),

:global([data-theme="light"] .cb-sl text) {
