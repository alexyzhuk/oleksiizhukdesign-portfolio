---
interface Props {
    role: string[];
    duration: string;
    team?: string[];
    tools?: string[];
}

const { role, duration, team, tools } = Astro.props;
---

<section class="px-4 sm:px-6 py-16 bg-text-primary/5">
    <div
        class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
    >
        <div>
            <h6 class="text-text-secondary mb-3">ROLE</h6>
            <div class="flex flex-col gap-1">
                {role.map((item) => <p class="text-base">{item}</p>)}
            </div>
        </div>

        <div>
            <h6 class="text-text-secondary mb-3">DURATION</h6>
            <p class="text-base">{duration}</p>
        </div>

        {
            team && (
                <div>
                    <h6 class="text-text-secondary mb-3">TEAM</h6>
                    <div class="flex flex-col gap-1">
                        {team.map((item) => (
                            <p class="text-base">{item}</p>
                        ))}
                    </div>
                </div>
            )
        }

        {
            tools && (
                <div>
                    <h6 class="text-text-secondary mb-3">TOOLS</h6>
                    <div class="flex flex-col gap-1">
                        {tools.map((item) => (
                            <p class="text-base">{item}</p>
                        ))}
                    </div>
                </div>
            )
        }
    </div>
</section>
