---
interface Props {
    company: string;
    companyColor: string;
    title: string;
    subtitle: string;
    coverImage: string;
    logo?: string;
    about: string;
    industry: string;
    duration: string;
    website?: string;
    sections: Array<{ id: string; title: string }>;
    nextCase?: { name: string; url: string };
    prevCase?: { name: string; url: string };
}

const {
    company,
    companyColor,
    title,
    subtitle,
    coverImage,
    logo,
    about,
    industry,
    duration,
    website,
    sections,
    nextCase,
    prevCase,
} = Astro.props;
---

<div class="case-study-container">
    <!-- Main Layout -->
    <div class="w-full px-4 sm:px-6 pb-12">
        <div class="max-w-7xl mx-auto">
            <!-- Top Navigation -->
            <div class="flex items-center justify-between mb-6">
                {
                    prevCase ? (
                        <a href={prevCase.url} class="cs-btn-secondary-square">
                            <svg
                                class="cs-arrow-right w-5 h-5 rotate-180"
                                viewBox="0 0 28 14"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20.7771 14L19.201 12.5388L23.839 8.0449L9.02452e-07 8.0449V5.9551L23.839 5.9551L19.201 1.46122L20.7771 -3.15721e-07L28 7L20.7771 14Z"
                                    fill="currentColor"
                                />
                            </svg>
                        </a>
                    ) : (
                        <a href="/" class="cs-btn-secondary-square">
                            <svg
                                class="cs-arrow-right w-5 h-5 rotate-180"
                                viewBox="0 0 28 14"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20.7771 14L19.201 12.5388L23.839 8.0449L9.02452e-07 8.0449V5.9551L23.839 5.9551L19.201 1.46122L20.7771 -3.15721e-07L28 7L20.7771 14Z"
                                    fill="currentColor"
                                />
                            </svg>
                        </a>
                    )
                }

                {
                    nextCase ? (
                        <a href={nextCase.url} class="cs-btn-secondary-square">
                            <svg
                                class="cs-arrow-right w-5 h-5"
                                viewBox="0 0 28 14"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20.7771 14L19.201 12.5388L23.839 8.0449L9.02452e-07 8.0449V5.9551L23.839 5.9551L19.201 1.46122L20.7771 -3.15721e-07L28 7L20.7771 14Z"
                                    fill="currentColor"
                                />
                            </svg>
                        </a>
                    ) : (
                        <a href="/#method" class="cs-btn-secondary-square">
                            <svg
                                class="cs-arrow-right w-5 h-5"
                                viewBox="0 0 28 14"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20.7771 14L19.201 12.5388L23.839 8.0449L9.02452e-07 8.0449V5.9551L23.839 5.9551L19.201 1.46122L20.7771 -3.15721e-07L28 7L20.7771 14Z"
                                    fill="currentColor"
                                />
                            </svg>
                        </a>
                    )
                }
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Main Content (Left) -->
                <main class="lg:col-span-8">
                    <img
                        src={coverImage}
                        class="flex rounded-2xl sm:rounded-3xl border border-stroke-weak-dark overflow-hidden mb-4 sm:mb-12"
                    />

                    <!-- Mobile TOC - Between Image and Content -->
                    <div class="lg:hidden mb-6">
                        <details
                            class="toc-mobile rounded-3xl border border-stroke-weak-dark bg-bg-plaque overflow-hidden transition-all duration-300"
                        >
                            <summary
                                class="flex items-center justify-between p-4 sm:p-6 cursor-pointer"
                            >
                                <span class="mono text-text-secondary"
                                    >Contents</span
                                >
                                <svg
                                    class="toc-chevron w-5 h-5 transition-transform duration-300"
                                    viewBox="0 0 10 22"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        d="M4.85547 0V21M4.85547 21L0.355469 16.5M4.85547 21L9.35547 16.5"
                                        stroke="#F9FAFB"></path>
                                </svg>
                            </summary>
                            <div class="toc-content">
                                <nav
                                    class="px-4 sm:px-6 pb-4 sm:pb-6 border-t border-stroke-weak-dark/50"
                                >
                                    <ul class="flex flex-col gap-3 pt-4">
                                        {
                                            sections.map((section) => (
                                                <li>
                                                    <a
                                                        href={`#${section.id}`}
                                                        class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200 toc-link block"
                                                        data-section={
                                                            section.id
                                                        }
                                                    >
                                                        {section.title}
                                                    </a>
                                                </li>
                                            ))
                                        }
                                    </ul>
                                </nav>
                            </div>
                        </details>
                    </div>

                    <!-- Main Content Slot -->
                    <slot />

                    <!-- Mobile Company Info - At Bottom -->
                    <div class="lg:hidden mt-12">
                        <div class="cs-card">
                            {
                                logo && (
                                    <div
                                        class={`flex items-center justify-center gap-3 w-full aspect-video rounded-lg ${companyColor}`}
                                    >
                                        <img
                                            src={logo}
                                            alt={company}
                                            class="w-1/2"
                                        />
                                    </div>
                                )
                            }

                            <div class="flex flex-col gap-4">
                                <div>
                                    <h5
                                        class="mono text-blue-light font-normal mb-0.5"
                                    >
                                        about:
                                    </h5>
                                    <p class="leading-7 text-text-secondary">
                                        {about}
                                    </p>
                                </div>

                                <div>
                                    <h5
                                        class="mono text-yellow-light font-normal mb-1"
                                    >
                                        industry:
                                    </h5>
                                    <p class="text-base text-text-secondary">
                                        {industry}
                                    </p>
                                </div>

                                <div>
                                    <h5
                                        class="mono text-green-light font-normal mb-1"
                                    >
                                        duration:
                                    </h5>
                                    <p class="text-base text-text-secondary">
                                        {duration}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>

                <!-- Desktop Sidebar (Right) -->
                <aside class="hidden lg:block lg:col-span-4">
                    <div class="sticky top-24 flex flex-col gap-6">
                        <!-- Company Info Card -->
                        <div class="cs-card">
                            {
                                logo && (
                                    <div
                                        class={`flex items-center justify-center gap-3 w-full aspect-video rounded-lg ${companyColor}`}
                                    >
                                        <img
                                            src={logo}
                                            alt={company}
                                            class="w-1/2"
                                        />
                                    </div>
                                )
                            }

                            <div class="flex flex-col gap-4">
                                <div>
                                    <h5
                                        class="mono text-blue-light font-normal mb-0.5"
                                    >
                                        about:
                                    </h5>
                                    <p class="leading-7 text-text-secondary">
                                        {about}
                                    </p>
                                </div>

                                <div>
                                    <h5
                                        class="mono text-yellow-light font-normal mb-1"
                                    >
                                        industry:
                                    </h5>
                                    <p class="text-base text-text-secondary">
                                        {industry}
                                    </p>
                                </div>

                                <div>
                                    <h5
                                        class="mono text-green-light font-normal mb-1"
                                    >
                                        duration:
                                    </h5>
                                    <p class="text-base text-text-secondary">
                                        {duration}
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Table of Contents -->
                        <nav class="cs-card">
                            <h4 class="text-sm mono text-text-secondary">
                                On this page
                            </h4>
                            <ul class="flex flex-col gap-3">
                                {
                                    sections.map((section) => (
                                        <li>
                                            <a
                                                href={`#${section.id}`}
                                                class="text-sm text-text-secondary hover:text-text-primary transition-colors duration-200 toc-link"
                                                data-section={section.id}
                                            >
                                                {section.title}
                                            </a>
                                        </li>
                                    ))
                                }
                            </ul>
                        </nav>
                    </div>
                </aside>
            </div>

            <!-- Bottom Navigation -->
            <div
                class="flex flex-col-reverse gap-4 sm:flex-row items-center justify-between mt-12"
            >
                {
                    prevCase ? (
                        <a href={prevCase.url} class="cs-btn-secondary">
                            <svg
                                class="cs-arrow-right w-5 h-5 rotate-180"
                                viewBox="0 0 28 14"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20.7771 14L19.201 12.5388L23.839 8.0449L9.02452e-07 8.0449V5.9551L23.839 5.9551L19.201 1.46122L20.7771 -3.15721e-07L28 7L20.7771 14Z"
                                    fill="currentColor"
                                />
                            </svg>
                            <span>Back to {prevCase.name}</span>
                        </a>
                    ) : (
                        <a href="/" class="cs-btn-secondary">
                            <svg
                                class="cs-arrow-right w-5 h-5 rotate-180"
                                viewBox="0 0 28 14"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20.7771 14L19.201 12.5388L23.839 8.0449L9.02452e-07 8.0449V5.9551L23.839 5.9551L19.201 1.46122L20.7771 -3.15721e-07L28 7L20.7771 14Z"
                                    fill="currentColor"
                                />
                            </svg>
                            <span>Back to home</span>
                        </a>
                    )
                }

                {
                    nextCase ? (
                        <a href={nextCase.url} class="cs-btn-primary">
                            <span>{nextCase.name}</span>
                            <svg
                                class="cs-arrow-right w-5 h-5"
                                viewBox="0 0 28 14"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20.7771 14L19.201 12.5388L23.839 8.0449L9.02452e-07 8.0449V5.9551L23.839 5.9551L19.201 1.46122L20.7771 -3.15721e-07L28 7L20.7771 14Z"
                                    fill="currentColor"
                                />
                            </svg>
                        </a>
                    ) : (
                        <a href="/#method" class="cs-btn-primary">
                            <span>Design Method</span>
                            <svg
                                class="cs-arrow-right w-5 h-5"
                                viewBox="0 0 28 14"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20.7771 14L19.201 12.5388L23.839 8.0449L9.02452e-07 8.0449V5.9551L23.839 5.9551L19.201 1.46122L20.7771 -3.15721e-07L28 7L20.7771 14Z"
                                    fill="currentColor"
                                />
                            </svg>
                        </a>
                    )
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Active state for TOC links */
    .toc-link.active {
        color: var(--color-text-primary);
        font-weight: 500;
    }

    /* Mobile TOC animations */
    .toc-mobile summary::-webkit-details-marker {
        display: none;
    }

    /* Animate chevron rotation */
    .toc-mobile[open] .toc-chevron {
        transform: rotate(180deg);
    }

    /* Animate content expansion/collapse using grid */
    .toc-content {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 300ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .toc-mobile[open] .toc-content {
        grid-template-rows: 1fr;
    }

    .toc-content > nav {
        overflow: hidden;
    }

    /* Ensure collapsing animation plays */
    .toc-mobile.is-closing {
        pointer-events: none;
    }
</style>

<script>
    // Handle smooth collapse animation
    const tocDetails = document.querySelector(".toc-mobile");
    const tocSummary = tocDetails?.querySelector("summary");

    if (tocDetails && tocSummary) {
        let isClosing = false;

        tocSummary.addEventListener("click", (e) => {
            // If we're currently closing, prevent any action
            if (isClosing) {
                e.preventDefault();
                return;
            }

            // If currently open and being clicked, handle collapse animation
            if (tocDetails.hasAttribute("open")) {
                e.preventDefault();
                isClosing = true;
                tocDetails.classList.add("is-closing");

                // Wait for animation to complete before actually closing
                setTimeout(() => {
                    tocDetails.removeAttribute("open");
                    tocDetails.classList.remove("is-closing");
                    isClosing = false;
                }, 300); // Match the CSS transition duration
            }
        });
    }

    // Intersection Observer for TOC active states
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                const id = entry.target.getAttribute("id");
                const tocLinks = document.querySelectorAll(
                    `[data-section="${id}"]`,
                );

                if (entry.isIntersecting) {
                    document.querySelectorAll(".toc-link").forEach((link) => {
                        link.classList.remove("active");
                    });
                    tocLinks.forEach((link) => link?.classList.add("active"));
                }
            });
        },
        {
            rootMargin: "-100px 0px -66%",
        },
    );

    // Observe all sections
    document.querySelectorAll("section[id]").forEach((section) => {
        observer.observe(section);
    });

    // Close mobile TOC when clicking a link
    document.querySelectorAll(".toc-mobile .toc-link").forEach((link) => {
        link.addEventListener("click", () => {
            const details = document.querySelector(".toc-mobile");
            const summary = details?.querySelector("summary");

            if (details && summary) {
                // Trigger the smooth close animation
                summary.click();
            }
        });
    });
</script>
