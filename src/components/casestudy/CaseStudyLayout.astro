---
interface Props {
    company: string;
    companyColor: string;
    title: string;
    subtitle: string;
    coverImage: string;
    logo?: string;
    about: string;
    industry: string;
    duration: string;
    website?: string;
    sections: Array<{ id: string; title: string }>;
    nextCase?: { name: string; url: string };
    prevCase?: { name: string; url: string };
}

const {
    company,
    companyColor,
    title,
    subtitle,
    coverImage,
    logo,
    about,
    industry,
    duration,
    website,
    sections,
    nextCase,
    prevCase,
} = Astro.props;
---

<div class="case-study-container mt-18">
    <!-- Main Layout -->
    <div class="w-full flex flex-col items-center justify-center">
        <div
            class="w-full max-w-7xl flex flex-col border-x border-stroke-weak-dark"
        >
            <div class="grid grid-cols-1 lg:grid-cols-12">
                <!-- Main Content (Left) -->
                <main
                    class="lg:col-span-8 lg:border-r border-stroke-weak-dark z-10"
                >
                    <img
                        src={coverImage}
                        alt={`${title} — ${company}`}
                        fetchpriority="high"
                        class="flex overflow-hidden mb-6 sm:mb-12"
                    />
                    <div
                        class="flex px-4 sm:px-6 flex-col gap-3 sm:gap-8 pb-6 sm:pb-12 sm:border-b border-stroke-weak-dark"
                    >
                        <h1 class="text-4xl sm:text-5xl font-bold">
                            {title}
                        </h1>
                        <p
                            class="text-base text-text-secondary text-balance leading-loose"
                        >
                            {subtitle}
                        </p>
                    </div>

                    <!-- Mobile Company Info - Above Contents -->
                    <div class="lg:hidden border-t border-stroke-weak-dark">
                        <div class="cs-card-blueprint">
                            {
                                logo && (
                                    <div class="px-4">
                                        <div
                                            class={`flex items-center justify-center w-full aspect-video border-b border-stroke-weak-dark ${companyColor}`}
                                        >
                                            <img
                                                src={logo}
                                                alt={company}
                                                class="w-3/4"
                                            />
                                        </div>
                                    </div>
                                )
                            }

                            <div class="flex flex-col">
                                <div
                                    class="p-4 sm:p-6 border-b border-stroke-weak-dark"
                                >
                                    <h5
                                        class="mono text-blue-light font-normal mb-2"
                                    >
                                        about:
                                    </h5>
                                    <p class="leading-7 text-text-secondary">
                                        {about}
                                    </p>
                                </div>

                                <div
                                    class="p-4 sm:p-6 border-b border-stroke-weak-dark"
                                >
                                    <h5
                                        class="mono text-yellow-light font-normal mb-2"
                                    >
                                        industry:
                                    </h5>
                                    <p class="text-base text-text-secondary">
                                        {industry}
                                    </p>
                                </div>

                                <div class="p-4 sm:p-6">
                                    <h5
                                        class="mono text-green-light font-normal mb-2"
                                    >
                                        duration:
                                    </h5>
                                    <p class="text-base text-text-secondary">
                                        {duration}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Mobile TOC - Between Image and Content -->
                    <div class="lg:hidden">
                        <details
                            class="toc-mobile border-t border-stroke-weak-dark overflow-hidden transition-all duration-300"
                        >
                            <summary
                                class="flex items-center justify-between p-4 sm:p-6 cursor-pointer border-b border-stroke-weak-dark"
                            >
                                <span class="text-xl font-medium tracking-tight"
                                    >Contents</span
                                >
                                <svg
                                    class="toc-chevron w-5 h-5 transition-transform duration-300"
                                    viewBox="0 0 10 22"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        d="M4.85547 0V21M4.85547 21L0.355469 16.5M4.85547 21L9.35547 16.5"
                                        stroke="#F9FAFB"></path>
                                </svg>
                            </summary>
                            <div
                                class="toc-content border-b border-stroke-weak-dark"
                            >
                                <nav>
                                    <ul class="flex flex-col py-6 px-4 sm:px-6">
                                        {
                                            sections.map((section) => (
                                                <li>
                                                    <a
                                                        href={`#${section.id}`}
                                                        class="flex border-l-2 border-text-secondary/20 text-lg text-text-secondary hover:text-text-primary/80 hover:border-text-primary/70 transition-colors duration-200 toc-link"
                                                        data-section={
                                                            section.id
                                                        }
                                                    >
                                                        {section.title}
                                                    </a>
                                                </li>
                                            ))
                                        }
                                    </ul>
                                </nav>
                            </div>
                        </details>
                    </div>

                    <!-- Main Content Slot -->
                    <slot />
                </main>

                <!-- Desktop Sidebar (Right) -->
                <aside class="hidden lg:block lg:col-span-4">
                    <!-- Company Info Card - Sticky at top -->
                    <div class="relative">
                        <div class="cs-card-blueprint pt-6">
                            {
                                logo && (
                                    <div class="px-6">
                                        <div
                                            class={`flex items-center justify-center w-full aspect-video border-b border-stroke-weak-dark ${companyColor}`}
                                        >
                                            <img
                                                src={logo}
                                                alt={company}
                                                class="w-3/4"
                                            />
                                        </div>
                                    </div>
                                )
                            }

                            <div class="flex flex-col">
                                <div
                                    class="border-b border-stroke-weak-dark p-4 pt-0 sm:p-6 sm:pt-0"
                                >
                                    <h5
                                        class="mono text-blue-light font-normal mb-2"
                                    >
                                        about:
                                    </h5>
                                    <p class="leading-7 text-text-secondary">
                                        {about}
                                    </p>
                                </div>

                                <div
                                    class="border-b border-stroke-weak-dark p-4 sm:p-6"
                                >
                                    <h5
                                        class="mono text-yellow-light font-normal mb-2"
                                    >
                                        industry:
                                    </h5>
                                    <p class="text-base text-text-secondary">
                                        {industry}
                                    </p>
                                </div>

                                <div
                                    class="p-4 sm:p-6 border-b border-stroke-weak-dark"
                                >
                                    <h5
                                        class="mono text-green-light font-normal mb-2"
                                    >
                                        duration:
                                    </h5>
                                    <p class="text-base text-text-secondary">
                                        {duration}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Table of Contents - Starts below company info, becomes centered on scroll -->
                    <div class="toc-wrapper">
                        <nav class="cs-card-blueprint p-6">
                            <h4 class="text-2xl font-medium tracking-tight">
                                Contents
                            </h4>
                            <ul class="flex flex-col">
                                {
                                    sections.map((section) => (
                                        <li>
                                            <a
                                                href={`#${section.id}`}
                                                class="flex border-l-2 border-text-secondary/20 px-4 sm:px-6 py-1 text-lg text-text-secondary hover:text-text-primary hover:border-text-primary/70 transition-colors duration-200 toc-link"
                                                data-section={section.id}
                                            >
                                                {section.title}
                                            </a>
                                        </li>
                                    ))
                                }
                            </ul>
                        </nav>
                    </div>
                </aside>
            </div>
        </div>
        <!-- Bottom Navigation -->
        <div
            class="flex border-t border-stroke-weak-dark w-full justify-center z-10"
        >
            <div
                class="flex flex-col-reverse gap-4 sm:flex-row items-center justify-between p-4 sm:py-6 sm:px-0 border-stroke-weak-dark border-x sm:border-x-0 max-w-7xl w-full"
            >
                {
                    prevCase ? (
                        <a href={prevCase.url} class="cs-btn-secondary">
                            <svg
                                class="cs-arrow-left w-5 h-5"
                                viewBox="0 0 28 14"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20.7771 14L19.201 12.5388L23.839 8.0449L9.02452e-07 8.0449V5.9551L23.839 5.9551L19.201 1.46122L20.7771 -3.15721e-07L28 7L20.7771 14Z"
                                    fill="currentColor"
                                />
                            </svg>
                            <span>Back to {prevCase.name} Case</span>
                        </a>
                    ) : (
                        <a href="/" class="cs-btn-secondary">
                            <svg
                                class="cs-arrow-left w-5 h-5"
                                viewBox="0 0 28 14"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20.7771 14L19.201 12.5388L23.839 8.0449L9.02452e-07 8.0449V5.9551L23.839 5.9551L19.201 1.46122L20.7771 -3.15721e-07L28 7L20.7771 14Z"
                                    fill="currentColor"
                                />
                            </svg>
                            <span>Back to home</span>
                        </a>
                    )
                }

                {
                    nextCase ? (
                        <a href={nextCase.url} class="cs-btn-primary">
                            <span>{nextCase.name} Case</span>
                            <svg
                                class="cs-arrow-right w-5 h-5"
                                viewBox="0 0 28 14"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20.7771 14L19.201 12.5388L23.839 8.0449L9.02452e-07 8.0449V5.9551L23.839 5.9551L19.201 1.46122L20.7771 -3.15721e-07L28 7L20.7771 14Z"
                                    fill="currentColor"
                                />
                            </svg>
                        </a>
                    ) : (
                        <a href="/#method" class="cs-btn-primary">
                            <span>Design Method</span>
                            <svg
                                class="cs-arrow-right w-5 h-5"
                                viewBox="0 0 28 14"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M20.7771 14L19.201 12.5388L23.839 8.0449L9.02452e-07 8.0449V5.9551L23.839 5.9551L19.201 1.46122L20.7771 -3.15721e-07L28 7L20.7771 14Z"
                                    fill="currentColor"
                                />
                            </svg>
                        </a>
                    )
                }
            </div>
        </div>
    </div>
</div>

<script>
    // Smooth scroll for TOC links
    document.querySelectorAll(".toc-link").forEach((link) => {
        link.addEventListener("click", (e) => {
            e.preventDefault();
            const targetId = link.getAttribute("href");
            const targetSection = document.querySelector(targetId);

            if (targetSection) {
                targetSection.scrollIntoView({
                    behavior: "smooth",
                    block: "start",
                });
            }
        });
    });

    // Scroll-triggered centered TOC
    const tocWrapper = document.querySelector(".toc-wrapper");
    let isCentered = false;

    if (tocWrapper) {
        const handleScroll = () => {
            const scrollPosition = window.scrollY;

            // Trigger sticky centered position after scrolling 300px
            if (scrollPosition > 300 && !isCentered) {
                isCentered = true;
                tocWrapper.classList.add("toc-centered");
            } else if (scrollPosition <= 300 && isCentered) {
                isCentered = false;
                tocWrapper.classList.remove("toc-centered");
            }
        };

        window.addEventListener("scroll", handleScroll);

        // Check initial position
        handleScroll();
    }

    // Handle smooth collapse animation for mobile TOC
    const tocDetails = document.querySelector(".toc-mobile");
    const tocSummary = tocDetails?.querySelector("summary");

    if (tocDetails && tocSummary) {
        let isClosing = false;

        tocSummary.addEventListener("click", (e) => {
            if (isClosing) {
                e.preventDefault();
                return;
            }

            if (tocDetails.hasAttribute("open")) {
                e.preventDefault();
                isClosing = true;
                tocDetails.classList.add("is-closing");

                setTimeout(() => {
                    tocDetails.removeAttribute("open");
                    tocDetails.classList.remove("is-closing");
                    isClosing = false;
                }, 300);
            }
        });
    }

    // Intersection Observer for TOC active states
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                const id = entry.target.getAttribute("id");
                const tocLinks = document.querySelectorAll(
                    `[data-section="${id}"]`,
                );

                if (entry.isIntersecting) {
                    document.querySelectorAll(".toc-link").forEach((link) => {
                        link.classList.remove("active");
                    });
                    tocLinks.forEach((link) => link?.classList.add("active"));
                }
            });
        },
        {
            rootMargin: "-100px 0px -66%",
        },
    );

    // Observe all sections
    document.querySelectorAll("section[id]").forEach((section) => {
        observer.observe(section);
    });

    // Close mobile TOC when clicking a link
    document.querySelectorAll(".toc-mobile .toc-link").forEach((link) => {
        link.addEventListener("click", () => {
            const details = document.querySelector(".toc-mobile");
            const summary = details?.querySelector("summary");

            if (details && summary) {
                summary.click();
            }
        });
    });
</script>
