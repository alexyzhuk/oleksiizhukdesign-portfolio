---
import BigQuestion from "./BigQuestion.astro";

interface Problem {
    icon: string;
    label?: string;
    title: string;
    description: string;
}

interface Goal {
    icon: string;
    label?: string;
    oldTitle?: string;
    newTitle: string;
    description: string;
}

interface Props {
    problems: Problem[];
    goals: Goal[];
    problemsTitle?: string;
    goalsTitle?: string;
    accentColor?: string;
}

const {
    problems,
    goals,
    problemsTitle = "Problems",
    goalsTitle = "Goals",
    accentColor = "text-blue-light",
} = Astro.props;
---

<div class="flex flex-col">
    <div class="max-w-7xl">
        <div class="flex flex-col max-w-200 mx-auto gap-10">
            <!-- Problems / Challenge -->
            <div class="flex flex-col">
                <h3 class={`mb-8 text-2xl`}>{problemsTitle}</h3>
                <div class="flex flex-col gap-8">
                    {
                        problems.map((problem) => (
                            <div class="flex flex-col gap-2">
                                <img
                                    src={problem.icon}
                                    alt={problem.title}
                                    class="w-12 h-12 mb-4"
                                />
                                <h4 class="text-lg sm:text-xl">
                                    {problem.title}
                                </h4>
                                <p class="text-stroke-weak text-base leading-loose text-balance">
                                    {problem.description}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Big Question -->
            <BigQuestion>
                <slot name="question" />
            </BigQuestion>

            <!-- Goals / Solution -->
            <div class="flex flex-col">
                <h3 class={`text-2xl mb-8`}>{goalsTitle}</h3>
                <div class="flex flex-col gap-8">
                    {
                        goals.map((goal) => (
                            <div class="flex flex-col gap-2">
                                <img
                                    src={goal.icon}
                                    alt={goal.newTitle}
                                    class="w-12 h-12 mb-4"
                                />
                                <p class="text-base sm:text-lg text-stroke-strong/70 line-through">
                                    {goal.oldTitle}
                                </p>
                                <h4 class="text-lg sm:text-xl">
                                    {goal.newTitle}
                                </h4>
                                <p class="text-stroke-weak text-base leading-loose text-balance">
                                    {goal.description}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</div>
