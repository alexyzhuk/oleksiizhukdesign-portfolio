---
interface Props {
    statValue: number;
    stat: string;
    value: string;
    label: string;
    blockColor: string;
}

const { statValue, stat, value, label, blockColor } = Astro.props;

// Ensure statValue is a number
const statNum = Number(statValue);
const overlayWidth = statNum < 0 ? Math.abs(statNum) : statNum;
const displayValue = statNum < 0 ? `${statNum}%` : `+${statNum}%`;

const colorMap: Record<string, string> = {
    "bg-blue-light": "var(--color-blue-light)",
    "bg-yellow-light": "var(--color-yellow-light)",
    "bg-green-light": "var(--color-green-light)",
    "bg-red-light": "var(--color-red-light)",
};

const bgColor = colorMap[blockColor] || blockColor;
---

<div class="flex flex-row gap-8 max-w-200 w-full mx-auto">
    <div class="relative w-full h-18 flex">
        <!-- Full-width colored background -->
        <div class="flex grow" style={`background-color: ${bgColor};`}></div>
        <!-- Semi-transparent overlay with value (width based on statValue) -->
        <div
            class="relative bg-bg-light/20 flex items-center"
            style={`width: ${overlayWidth}%;`}
        >
            <div class="flex flex-col p-4">
                <p class="text-text-primary text-lg font-medium leading-6">
                    {value}
                </p>
                <p class="text-text-secondary text-sm leading-4">{label}</p>
            </div>
        </div>
    </div>
    <!-- Stat display on the right -->
    <div class="relative flex-1 flex flex-col items-end justify-center w-fit">
        <p class="text-5xl font-medium text-text-primary">
            {displayValue}
        </p>
        <p class="text-2xl text-text-primary whitespace-nowrap">{stat}</p>
    </div>
</div>
