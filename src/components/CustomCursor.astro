---
// Custom cursor that follows mouse
---

<div id="custom-cursor" class="custom-cursor"></div>

<style>
    .custom-cursor {
        position: fixed;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background-color: rgba(249, 250, 251, 0.32);
        mix-blend-mode: difference;
        pointer-events: none;
        z-index: 9999;
        transform: translate(-50%, -50%);
        border: 1px solid transparent;
        transition:
            width 0.5s cubic-bezier(0.5, 1, 0.89, 1),
            height 0.5s cubic-bezier(0.5, 1, 0.89, 1),
            border 0.5s cubic-bezier(0.5, 1, 0.89, 1),
            background-color 0.5s cubic-bezier(0.5, 1, 0.89, 1);
    }
    .custom-cursor.hover {
        width: 32px;
        height: 32px;
        border: 1px solid rgba(249, 250, 251, 0.48);
    }
    .custom-cursor.active {
        width: 24px;
        height: 24px;
    }
</style>

<script>
    const cursor = document.getElementById("custom-cursor");
    let mouseX = 0;
    let mouseY = 0;
    let cursorFrame: number;

    if (cursor) {
        // Track mouse position
        document.addEventListener("mousemove", (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            cursor.style.left = mouseX + "px";
            cursor.style.top = mouseY + "px";
        });

        // Check what's under cursor every frame
        const checkCursorState = () => {
            const element = document.elementFromPoint(mouseX, mouseY);
            const interactiveElements =
                'a, button, input, textarea, select, [role="button"], .tool-icon, .has-cursor-pointer';

            if (element?.closest(interactiveElements)) {
                cursor.classList.add("hover");
            } else {
                cursor.classList.remove("hover");
            }

            cursorFrame = requestAnimationFrame(checkCursorState);
        };

        // Start checking
        checkCursorState();

        // Detect mouse down/up
        document.addEventListener("mousedown", () => {
            cursor.classList.add("active");
        });

        document.addEventListener("mouseup", () => {
            cursor.classList.remove("active");
        });

        // Cleanup
        window.addEventListener("beforeunload", () => {
            cancelAnimationFrame(cursorFrame);
        });
    }
</script>
