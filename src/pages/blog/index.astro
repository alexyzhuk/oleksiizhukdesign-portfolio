---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Render each post's body so the feed shows the full content inline.
const rendered = await Promise.all(
    posts.map(async (post) => ({
        post,
        Content: (await render(post)).Content,
    })),
);

const fmt = (d: Date) =>
    d.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
---

<BaseLayout
    title="Blog · Oleksii Zhuk"
    description="Notes on product design, UX, and building for the web."
>
    <section
        class="w-full flex flex-col items-center justify-center z-10 mt-18"
    >
        <div
            class="w-full max-w-7xl flex flex-col pt-12 sm:pt-24 pb-6 gap-6 px-4 sm:px-6 border-x border-stroke-weak-dark"
        >
            <h1 class="text-4xl sm:text-5xl font-medium">Blog</h1>
            <p
                class="sm:text-lg text-balance leading-loose text-text-secondary max-w-[64ch]"
            >
                Notes on product design, UX, and building for the web.
            </p>
        </div>

        <div
            class="w-full flex flex-col items-center border-t border-stroke-weak-dark"
        >
            <div class="w-full max-w-7xl border-x border-stroke-weak-dark">
                {
                    rendered.map(({ post, Content }) => (
                        <article class="flex flex-col gap-4 p-6 sm:p-12 border-b border-stroke-weak-dark">
                            <div class="flex flex-col gap-3">
                                <a
                                    href={`/blog/${post.id}`}
                                    class="mono text-sm text-text-secondary hover:text-text-primary transition-colors w-fit"
                                >
                                    {fmt(post.data.pubDate)}
                                </a>
                                <h2 class="text-3xl sm:text-4xl font-medium tracking-tight text-balance">
                                    <a
                                        href={`/blog/${post.id}`}
                                        class="hover:opacity-80 transition-opacity"
                                    >
                                        {post.data.title}
                                    </a>
                                </h2>
                            </div>
                            <div class="blog-prose">
                                <Content />
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>
</BaseLayout>
