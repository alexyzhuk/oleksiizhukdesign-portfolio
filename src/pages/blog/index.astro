---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Render each post's body so the feed shows the full content inline.
const rendered = await Promise.all(
    posts.map(async (post) => ({
        post,
        Content: (await render(post)).Content,
    })),
);

const fmt = (d: Date) =>
    d.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
---

<BaseLayout
    title="Blog · Oleksii Zhuk"
    description="Notes on product design, UX, and building for the web."
>
    <section
        class="w-full flex flex-col items-center justify-center z-10 mt-18"
    >
        <div
            class="w-full max-w-7xl flex flex-col items-center text-center pt-12 sm:pt-24 pb-6 gap-6 px-4 sm:px-6 border-x border-stroke-weak-dark"
        >
            <h1 class="text-4xl sm:text-5xl font-medium">Blog</h1>
            <p
                class="sm:text-lg text-balance leading-loose text-text-secondary max-w-[64ch]"
            >
                Notes on product design, UX, and building for the web.
            </p>
        </div>

        <div class="w-full flex flex-col">
            {
                rendered.map(({ post, Content }, index) => (
                    <>
                        <div
                            id={post.id}
                            class="w-full flex flex-col items-center border-y border-stroke-weak-dark scroll-mt-24"
                        >
                            <article class="w-full max-w-7xl border-x border-stroke-weak-dark flex flex-col items-center p-6 sm:p-12 bg-bg-plaque">
                                <div class="w-full max-w-3xl flex flex-col gap-4">
                                    <div class="flex flex-col gap-3">
                                        <span class="mono text-sm text-text-secondary">
                                            {fmt(post.data.pubDate)}
                                        </span>
                                        <h2 class="text-2xl sm:text-3xl font-medium tracking-tight text-balance">
                                            {post.data.title}
                                        </h2>
                                    </div>

                                    <div class="blog-prose">
                                        <Content />
                                    </div>

                                    <div class="flex items-center gap-2 pt-4">
                                        <button
                                            type="button"
                                            class="blog-copy flex items-center gap-2 mono text-sm text-text-secondary hover:text-text-primary transition-colors px-3.5 py-2 rounded-full border border-stroke-weak-dark"
                                            data-post={post.id}
                                            aria-label="Copy link to this post"
                                        >
                                            <svg
                                                class="w-4 h-4"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="1.8"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            >
                                                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                                                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                                            </svg>
                                            <span class="blog-copy-label">Copy link</span>
                                        </button>
                                    </div>
                                </div>
                            </article>
                        </div>
                        {index < rendered.length - 1 && (
                            <div class="flex border-x border-stroke-weak-dark w-full max-w-7xl h-12 sm:h-16 mx-auto" />
                        )}
                    </>
                ))
            }
        </div>
    </section>
</BaseLayout>

<script>
    // Copy link — copies the post's anchor URL in the feed.
    document.querySelectorAll<HTMLButtonElement>(".blog-copy").forEach((btn) => {
        const id = btn.getAttribute("data-post");
        const label = btn.querySelector(".blog-copy-label");

        btn.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText(
                    `${location.origin}/blog#${id}`,
                );
                if (!label) return;
                const prev = label.textContent;
                label.textContent = "Copied!";
                btn.classList.add("text-green-light", "border-green-light");
                setTimeout(() => {
                    label.textContent = prev;
                    btn.classList.remove(
                        "text-green-light",
                        "border-green-light",
                    );
                }, 1500);
            } catch {
                /* clipboard unavailable */
            }
        });
    });
</script>
