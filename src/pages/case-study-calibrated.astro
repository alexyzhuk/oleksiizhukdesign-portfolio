---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyLayout from "../components/casestudy/CaseStudyLayout.astro";
import Table from "../components/casestudy/Table.astro";
import ImageBlock from "../components/casestudy/ImageBlock.astro";

// More case-study images can be dropped into public/ (or
// public/case-study-calibrated/) and wired into <ImageBlock>/<Gallery> slots.
---

<BaseLayout
    title="Calibrated - Calibrating Communications"
    description="Brand identity, logo, and website for a strategic communications agency."
>
    <CaseStudyLayout
        company="Calibrated"
        companyColor="bg-[#FFFFFF]"
        logo="/calibrated-logo.svg"
        title="Calibrating Communications"
        subtitle="In 2024, Calibrated set out to earn credibility in a field that runs on it — public advocacy for defence tech, cybersecurity, and cognitive security. I was brought in to build the brand from the ground up: identity, logo, and a website that make a young agency stand out as a reliable partner."
        coverImage="/calibrated-cover.avif"
        about="Calibrated is a Ukraine-based communications agency with a global focus, calibrating public advocacy and comms for defence tech, cybersecurity, and cognitive security. The team brings deep expertise in strategic communications — global PR, reputation management, and impactful narratives."
        industry="Defence Tech, Cybersecurity, Strategic Comms"
        duration="2024"
        website="https://calibrated.agency/"
        prevCase={{ name: "Osvita XXI", url: "/case-study-osvita" }}
        nextCase={{ name: "Cascade Systems", url: "/case-study-cascade-systems" }}
        sections={[
            { id: "overview", title: "Overview" },
            { id: "challenge", title: "The Challenge" },
            { id: "brand", title: "Brand Identity" },
            { id: "results", title: "Results" },
            { id: "finished-product", title: "Finished Product" },
            { id: "press", title: "Press" },
        ]}
    >
        <div class="flex flex-col">
            <!-- OVERVIEW SECTION -->
            <section id="overview" class="cs-section">
                <div>
                    <h2 class="cs-h2">Overview</h2>
                    <div class="cs-text">
                        <p>
                            When Calibrated launched in 2024, it had sharp
                            StratCom expertise and a clear vision — but no brand
                            to show for it. It was stepping into defence tech
                            and cybersecurity, domains where reputation is
                            earned slowly and scrutinized closely.
                        </p>
                        <p>
                            My role spanned the full visual identity — logo,
                            brand system, and the website that ties it all
                            together. Every decision answered one question: how
                            do you make a brand-new agency look like a partner
                            you can trust with your own reputation?
                        </p>
                    </div>
                </div>

                <div class="cs-subsection w-full">
                    <h3 class="cs-h3">Roles & Responsibilities</h3>
                    <Table
                        columns={[{ key: "role" }, { key: "responsibilities" }]}
                        data={[
                            {
                                role: "Web Designer",
                                responsibilities:
                                    "Designing and building a responsive, accessible marketing website on Framer — a foundation to support the agency's bootcamps and marketing campaigns.",
                            },
                            {
                                role: "Brand Designer",
                                responsibilities:
                                    "Brand identity and brand kit with a cohesive visual language.",
                            },
                            {
                                role: "Logo Designer",
                                responsibilities:
                                    "A contemporary, minimalist logo built to work across both digital and print.",
                            },
                            {
                                role: "Graphic Designer",
                                responsibilities:
                                    "Icons, pictograms, and other graphic assets for future campaigns.",
                            },
                        ]}
                    />
                </div>

                <div class="cs-subsection w-full">
                    <h3 class="cs-h3">Platform</h3>
                    <Table
                        columns={[{ key: "platform" }, { key: "purpose" }]}
                        data={[
                            {
                                platform: "Desktop Web",
                                purpose:
                                    "A responsive, minimalist marketing website with a clear, trustworthy presentation.",
                            },
                            {
                                platform: "Mobile (Responsive) Web",
                                purpose:
                                    "Fully responsive layouts optimized for readability on smaller screens.",
                            },
                        ]}
                    />
                </div>
            </section>

            <!-- CHALLENGE SECTION -->
            <section id="challenge" class="cs-section">
                <div>
                    <h2 class="cs-h2">The Challenge</h2>
                    <div class="cs-text">
                        <p>
                            The hard part wasn't making Calibrated look good —
                            it was making it look trustworthy without looking
                            dated. Defence and security audiences are wary of
                            anything that reads as marketing gloss, yet a
                            brand-new agency has no track record to fall back
                            on. The identity had to feel contemporary and
                            confident, but restrained enough to signal a serious
                            partner — and hold up equally in a pitch deck, on
                            the website, and across campaigns.
                        </p>
                    </div>
                </div>
            </section>

            <!-- BRAND IDENTITY SECTION -->
            <section id="brand" class="cs-section">
                <div>
                    <h2 class="cs-h2">Brand Identity</h2>
                    <div class="cs-text">
                        <p>
                            The answer was restraint. A contemporary, minimalist
                            logo and a tight, monochrome-leaning palette do the
                            heavy lifting — enough polish to feel current,
                            little enough decoration to read as serious.
                            Typography carries the confidence: clean,
                            structured, and quietly authoritative.
                        </p>
                        <p>
                            The dot on the i doubles as the mark's accent — a
                            nod to the Ukrainian idiom about dotting your i's: a
                            small signal of clarity, decisiveness, and attention
                            to detail.
                        </p>
                    </div>
                </div>

                <div
                    class="py-2 sm:py-8 w-full flex items-center justify-center"
                >
                    <img
                        src="/calibrated-logo-inverted.svg"
                        alt="Calibrated logo"
                    />
                </div>
                <div class="cs-text">
                    <p>
                        Beyond the logo, the identity had to scale. I pulled
                        every element into a single design system — reusable
                        components, spacing, and rules — so the brand stays
                        consistent and unmistakably Calibrated everywhere it
                        appears, from the website to a campaign deck.
                    </p>
                </div>

                <div class="cs-subsection">
                    <h3 class="cs-h3">Design System</h3>
                    <div class="text-text-primary">
                        <ImageBlock
                            src="/calibrated-design-system.avif"
                            alt="Calibrated design system"
                            caption="The design system I developed for Calibrated — components, typography, and color, keeping the brand consistent across the site."
                        />
                    </div>
                </div>
            </section>
        </div>

        <!-- RESULTS SECTION -->
        <section id="results" class="cs-section">
            <div>
                <h2 class="cs-h2">Results</h2>
                <div class="cs-text">
                    <p>
                        With the brand and site in place, Calibrated had a
                        foundation that could carry real momentum — and the
                        early numbers backed it up.
                    </p>
                </div>
            </div>
            <div class="w-full">
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 border-y border-stroke-weak-dark"
                >
                    <div
                        class="flex flex-col gap-8 p-6 sm:p-8 bg-bg-plaque border-b sm:border-b-0 sm:border-r border-stroke-weak-dark"
                    >
                        <div class="flex items-center justify-between gap-4">
                            <span
                                class="text-xl font-medium tracking-tight text-text-primary"
                            >
                                First Year
                            </span>
                            <span class="text-green-light">
                                <svg
                                    viewBox="0 0 256 256"
                                    fill="currentColor"
                                    class="size-7"
                                >
                                    <path
                                        d="M32,64a8,8,0,0,1,8-8H216a8,8,0,0,1,0,16H40A8,8,0,0,1,32,64Zm8,72h72a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16Zm88,48H40a8,8,0,0,0,0,16h88a8,8,0,0,0,0-16Zm109.66,13.66a8,8,0,0,1-11.32,0L206,177.36A40,40,0,1,1,217.36,166l20.3,20.3A8,8,0,0,1,237.66,197.66ZM184,168a24,24,0,1,0-24-24A24,24,0,0,0,184,168Z"
                                    ></path>
                                </svg>
                            </span>
                        </div>
                        <div class="flex flex-col gap-1">
                            <span
                                class="text-5xl sm:text-6xl font-medium tracking-tight text-green-light"
                            >
                                100k
                            </span>
                            <span class="mono text-sm text-text-secondary">
                                search impressions
                            </span>
                        </div>
                    </div>

                    <!-- Clicks -->
                    <div class="flex flex-col gap-8 p-6 sm:p-8 bg-bg-plaque">
                        <div class="flex items-center justify-between gap-4">
                            <span
                                class="text-xl font-medium tracking-tight text-text-primary"
                            >
                                Latest Campaign
                            </span>
                            <span class="text-blue-light">
                                <svg
                                    viewBox="0 0 256 256"
                                    fill="currentColor"
                                    class="size-7"
                                >
                                    <path
                                        d="M88,24V16a8,8,0,0,1,16,0v8a8,8,0,0,1-16,0ZM16,104h8a8,8,0,0,0,0-16H16a8,8,0,0,0,0,16ZM124.42,39.16a8,8,0,0,0,10.74-3.58l8-16a8,8,0,0,0-14.31-7.16l-8,16A8,8,0,0,0,124.42,39.16Zm-96,81.69-16,8a8,8,0,0,0,7.16,14.31l16-8a8,8,0,1,0-7.16-14.31ZM219.31,184a16,16,0,0,1,0,22.63l-12.68,12.68a16,16,0,0,1-22.63,0L132.7,168,115,214.09c0,.1-.08.21-.13.32a15.83,15.83,0,0,1-14.6,9.59l-.79,0a15.83,15.83,0,0,1-14.41-11L32.8,52.92A16,16,0,0,1,52.92,32.8L213,85.07a16,16,0,0,1,1.41,29.8l-.32.13L168,132.69ZM208,195.31,156.69,144h0a16,16,0,0,1,4.93-26l.32-.14,45.95-17.64L48,48l52.2,159.86,17.65-46c0-.11.08-.22.13-.33a16,16,0,0,1,11.69-9.34,16.72,16.72,0,0,1,3-.28,16,16,0,0,1,11.3,4.69L195.31,208Z"
                                    ></path>
                                </svg>
                            </span>
                        </div>
                        <div class="flex flex-col gap-1">
                            <span
                                class="text-5xl sm:text-6xl font-medium tracking-tight text-blue-light"
                            >
                                +300%
                            </span>
                            <span class="mono text-sm text-text-secondary">
                                clicks
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FINISHED PRODUCT SECTION -->
        <section id="finished-product" class="cs-section-final">
            <div>
                <h2 class="cs-h2">Finished Product</h2>
                <div class="cs-text">
                    <p>
                        The finished site launched in 2024 and now anchors
                        Calibrated's presence — from investor conversations to
                        its Defence Tech Comms Bootcamp.
                    </p>
                    <p>
                        The website brings it together — a fast, responsive
                        Framer build with a clear hierarchy that lets the
                        agency's expertise, not the design, take center stage.
                        Everything ladders up to one impression: a credible
                        partner who has done this before.
                    </p>
                    <a
                        href="https://calibrated.agency/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="light-btn w-fit"
                    >
                        View Live Website
                    </a>
                </div>
            </div>

            <div class="w-full flex flex-col pb-8 sm:pb-12">
                <ImageBlock
                    src="/calibrated-final.avif"
                    alt="Calibrated"
                    fullWidth={true}
                    noPadding={true}
                />
                {
                    /* TODO: add more showcase images from public/case-study-calibrated/ */
                }
            </div>
        </section>

        <!-- PRESS SECTION -->
        <section id="press" class="cs-section-final pb-6">
            <div>
                <h2 class="cs-h2">Press</h2>
                <div class="cs-text">
                    <p>
                        Because the identity was built as a system, scaling it
                        into new contexts took no extra effort. When Business
                        Ukraine magazine featured the agency, the brand carried
                        straight onto the printed page — consistent, and
                        unmistakably Calibrated.
                    </p>
                </div>
            </div>

            <div class="w-full flex flex-col">
                <ImageBlock
                    src="/calibrated-feature.avif"
                    alt="Calibrated featured in Business Ukraine magazine"
                    caption="Featured in Business Ukraine magazine"
                    fullWidth={true}
                    noPadding={true}
                />
            </div>
        </section>
    </CaseStudyLayout>
</BaseLayout>
